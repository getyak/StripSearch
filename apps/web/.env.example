# StripSearch Web Alpha — server-only environment.
# Copy to `.env` (ignored by Git) and fill only if you want the optional providers.
# The server never exposes these values to the browser bundle, logs or /api/health.

# Optional. Without it, Exa stays visibly "未配置" and the Exa source is disabled.
# Never commit a real key.
EXA_API_KEY=

# Optional. GitHub public reads work without a token; a token raises the anonymous
# rate limit only. Server-side only.
GITHUB_TOKEN=

# Overrides: bind stays loopback-only. Remote hosts are rejected by config.
# PORT=4392
# STRIPSEARCH_DATA_DIR=./apps/web/.data

# Deployment mode. `local` (default) keeps HTTP on loopback.
# `hosted` requires an explicit HTTPS public origin and is meant to sit behind a
# local reverse proxy that terminates TLS while this process keeps the loopback bind.
# STRIPSEARCH_DEPLOYMENT=local

# Local: trusted same-origin, must be HTTP on loopback and match PORT.
# Hosted: required, must be HTTPS with no credentials/path/query/fragment/wildcards.
# There is exactly one allowed origin in hosted mode.
# STRIPSEARCH_PUBLIC_ORIGIN=http://localhost:4392
# STRIPSEARCH_PUBLIC_ORIGIN=https://search.example.com

# Hosted only: exact, comma-separated, case-insensitive signup allowlist.
# Unset or empty rejects every new registration while existing accounts can
# still sign in. Wildcards are not supported.
# STRIPSEARCH_SIGNUP_EMAILS=alice@example.com,bob@example.com

# Hosted reverse-proxy contract: terminate TLS at the proxy and overwrite
# X-Forwarded-For (optionally X-Real-IP) with the immediate client IP. Never
# append, and never accept these headers from clients. Proxy to the loopback
# PORT; the server pins host/proto to STRIPSEARCH_PUBLIC_ORIGIN and only trusts
# forwarded client IPs from loopback hops.

# Person research requires both DeepSeek and Exa. Credentials stay server-side.
DEEPSEEK_API_KEY=
STRIPSEARCH_DEEPSEEK_MODEL=deepseek-flash
# Optional fallback/social tools; missing credentials remain visible as gaps.
FIRECRAWL_API_KEY=
TIKHUB_API_KEY=
