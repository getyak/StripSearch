+      return {
+        run: this.store.getRun(run.id)!,
+        input: view,
+        caseId: revision.caseId,
+        scopeVersion,
+        emailUnsupported,
+        roleAmbiguity: classification.ambiguities,
+        queueable
+      };
+    });
+  }
+
+  /**
+   * Role confirmation must come from the server's current input/candidate
+   * version: the choice is checked against the classification the server
+   * itself computed or stored, never against client-supplied role data.
+   */
+  private resolveRoleChoice(
+    ownerId: string,
+    source: ResearchInputClassification,
+    choice: RoleChoiceRequest
+  ): ResearchInputClassification {
+    const ambiguity = source.ambiguities[0];
+    if (!ambiguity || !ambiguity.options.includes(choice.choice)) {
+      throw new HttpError(409, 'role_choice_conflict', '角色确认与当前输入不一致，请重新查看后确认。');
+    }
+    if (choice.choice === 'select_resource_account') {
+      const candidate = ambiguity.candidate;
+      if (!candidate) {
+        throw new HttpError(409, 'role_choice_conflict', '该链接没有可选定的账号线索。');
+      }
+      return {
+        ...source,
+        accountSeed: candidate,
+        ambiguities: [],
+        intendedScope: 'account_only',
+        notes: [
+          ...source.notes,
+          '用户确认把链接中的账号选为研究范围；身份支持保持 proposed，作者/发布者/研究对象仍不合并。'
+        ]
+      };
+    }
+    void ownerId;
+    return {
+      ...source,
+      accountSeed: null,
+      ambiguities: [],
+      intendedScope: 'resource_research',
+      notes: [...source.notes, '用户确认该链接只作为资料来源，不建立人物账号范围。']
+    };
+  }
+
+  /** Explicit subject-email authorization; never inferred, never generic. */
+  private recordEmailAuthorization(
+    request: SubmitInputRequest,
+    caseRecord: ResearchCase,
+    revision: InputRevisionRecord
+  ): InputAuthorizationRecord {
+    const consent = request.emailConsent;
+    if (!consent) {
+      throw new HttpError(
+        422,
+        'email_authorization_required',
+        '研究邮箱线索需要明确授权：请确认这是本人邮箱，或已获得邮箱所有者的明确同意。'
+      );
+    }
+    if ('authorizationRef' in consent) {
+      try {
+        return this.store.inputs.resolveAuthorization(request.ownerId, request.ownerId, consent.authorizationRef, {
+          normalizedValue: revision.normalizedValue,
+          inputRevision: revision.revision
+        });
+      } catch (error) {
+        if (error instanceof InputAuthorizationError) {
+          throw new HttpError(403, error.code, error.message);
+        }
+        throw error;
+      }
+    }
