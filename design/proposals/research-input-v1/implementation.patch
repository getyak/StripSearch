+  /**
+   * One authoritative scope path: selected accounts go through the atomic
+   * GET-58 `applyScopeChange`; a subject change on a continued case advances
+   * the case-level scope version. No competing scope counter, no fake
+   * accounts for account-less first inputs.
+   */
+  private applyInputScope(
+    ownerId: string,
+    caseRecord: ResearchCase,
+    revision: InputRevisionRecord,
+    classification: ResearchInputClassification,
+    viaRoleChoice: boolean
+  ): ScopeVersion {
+    const seed = classification.accountSeed;
+    if (seed) {
+      const existing = this.store.cases
+        .listAccounts(ownerId, caseRecord.caseId)
+        .find(
+          (account) =>
+            account.platform === (seed.platform ?? 'web') &&
+            account.handle === seed.handle &&
+            (seed.profileUrl === null || account.profileUrl === seed.profileUrl)
+        );
+      const draft: AccountDraft = {
+        platform: seed.platform ?? 'web',
+        handle: seed.handle,
+        profileUrl: seed.profileUrl,
+        identitySupport: {
+          state: 'proposed',
+          evidenceIds: [],
+          counterevidenceIds: [],
+          policyVersion: IDENTITY_POLICY_VERSION,
+          note: '输入种子只是账号线索；没有身份证据。'
+        },
+        userSelection: {
+          state: 'selected',
+          note: viaRoleChoice ? '用户确认选择该账号作为研究范围。' : '明确种子：用户选择研究该账号。',
+          recordedAt: nowIso()
+        },
+        allowedScope: { state: 'public_history', note: '仅读取公开资料。' },
+        researchValue: { state: 'unassessed', rationale: null },
+        accessCoverage: { state: 'unassessed', earliestReadAt: null, note: null }
