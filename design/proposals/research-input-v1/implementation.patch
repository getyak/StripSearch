+/**
+ * GET-62 intake through the REAL composition: main-form style POST →
+ * /api/runs → ResearchInputService → SQLite Store (cases/inputs/scope) →
+ * Runner queue. Providers and the transport are fake or denied; nothing here
+ * touches the network. Assertions observe actual DB rows, queue state and
+ * transport calls, not just response shapes.
+ *
+ * Sign-ups are deliberately consolidated (Better Auth keeps a shared auth
+ * rate-limit bucket in tests); each group owns one server and asserts on
+ * relative row counts.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { startTestServer, waitFor, TestClient } from './harness.js';
+import type { TestServer } from './harness.js';
+import { createFakeFactory } from './fakes.js';
+import type { CanonicalView } from '../shared/types.js';
+import type { ResearchPlanner } from '../server/research/planner.js';
+import type { ResearchPage, ResearchTools } from '../server/research/tool-contracts.js';
+import type { HttpTransport, HttpRequestInit, HttpResponseLike } from '../server/adapters/types.js';
+import { DEFAULT_DISCOVERY_LIMITS } from '../shared/platform-discovery.js';
+
+const EMAIL_RAW = 'A.B+Tag@Example.TEST';
+const EMAIL_NORMALIZED = 'A.B+Tag@example.test';
+const EMAIL_HASH = createHash('sha256').update(EMAIL_NORMALIZED).digest('hex');
+
+class DenyTransport implements HttpTransport {
+  readonly calls: string[] = [];
+  async fetch(url: string, _init?: HttpRequestInit): Promise<HttpResponseLike> {
+    this.calls.push(url);
+    return { status: 599, ok: false, headers: { get: () => null }, text: async () => '' };
+  }
+}
+
+function profile(handle: string): ResearchPage {
+  return {
+    url: `https://github.com/${handle}`,
+    title: handle,
+    text: `${handle} builds synthetic compilers.`,
+    kind: 'profile',
+    publishedAt: null,
+    links: [],
+    limitations: [],
+    account: { platform: 'github', handle, id: handle, profileUrl: `https://github.com/${handle}` }
+  };
+}
+
+function fixtureTools(seen: { actions: unknown[] }): ResearchTools {
+  return {
+    async execute(action) {
+      seen.actions.push(action);
+      return {
+        pages:
+          action.type === 'search'
+            ? [profile('fixture-owner')]
+            : [profile(new URL(action.url).pathname.slice(1))],
+        requests: 1,
+        bytes: 80,
+        estimatedUsd: 0.001,
+        credits: null,
+        limitations: []
+      };
+    }
+  };
+}
+
+function fixturePlanner(seen: { inputs: unknown[] }): ResearchPlanner {
+  return {
+    async decide(input) {
+      seen.inputs.push(input);
+      if (input.mode === 'verify') return { supported: [0], rejected: [] };
+      return {
+        action: 'finish',
+        claims: [{ sourceKey: 'S1', quote: input.checkpoint.pages[0]?.text ?? 'fixture' }],
+        unknowns: []
+      };
+    }
+  };
+}
+
+interface RunResponse {
+  run: CanonicalView;
+  idempotent: boolean;
+  input: { inputId: string; inputRevision: number; kind: string; displayValue: string; status: string } | null;
+  roleAmbiguity: { code: string; options: string[] }[];
+  emailUnsupported: boolean;
+  queued: boolean;
+}
+
+interface ErrorBody {
+  error: { code: string; message: string; details?: unknown };
+}
+
+function countRows(server: TestServer, table: string): number {
+  const row = server.boot.db.prepare(`SELECT COUNT(*) AS n FROM ${table}`).get() as { n: number };
+  return row.n;
+}
+
+async function currentUser(target: TestServer | TestClient): Promise<{ id: string }> {
+  const client = target instanceof TestClient ? target : target.client;
+  const session = await client.json<{ user?: { id: string } }>('/api/auth/get-session');
+  assert.ok(session.body && session.body.user, 'test user must be signed in');
+  return session.body.user!;
+}
+
+function assertNoEmailLeak(text: string, context: string): void {
+  assert.equal(text.includes('A.B+Tag'), false, `${context}: raw local part leaked`);
+  assert.equal(text.includes(EMAIL_RAW), false, `${context}: raw email leaked`);
+  assert.equal(text.includes('Person@Example.TEST'), false, `${context}: raw email leaked`);
+  assert.equal(text.toLowerCase().includes('example.test'), false, `${context}: email domain leaked`);
+  assert.equal(text.includes(EMAIL_HASH), false, `${context}: email hash leaked`);
+}
+
+const RESEARCH_ENV = { DEEPSEEK_API_KEY: 'offline-fixture', EXA_API_KEY: 'offline-fixture' };
