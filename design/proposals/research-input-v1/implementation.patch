+      if (!queueable) {
+        this.store.addEvent(run.id, 'needs_input', {
+          prompt: emailUnsupported
+            ? '邮箱公开匹配（GET-66）尚未实现。请补充该对象的公开主页链接后继续。'
+            : (classification.ambiguities[0]?.message ?? '请确认研究对象。'),
+          input: view,
+          fallback: emailUnsupported ? 'public_profile' : 'role_confirmation',
+          roleOptions: classification.ambiguities.flatMap((ambiguity) => ambiguity.options),
