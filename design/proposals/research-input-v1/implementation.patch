+/**
+ * GET-62 client behavior: the input box classifies locally and never leaks
+ * before an explicit submit. Typing, pasting, blur and preview send no request
+ * or telemetry and invoke no provider; email previews are redacted; explicit
+ * submit is gated on a scoped email authorization; consent is invalidated by
+ * input changes and account switches; the login-callback auto-submit
+ * revalidates the CURRENT input and user; role ambiguity is confirmed through
+ * a real payload bound to the server's input revision.
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { SCHEMA_VERSION } from '../shared/types.js';
+import type { CanonicalView } from '../shared/types.js';
+import { installDom, installFetch, jsonResponse, MockEventSource } from './dom-env.js';
+
+const env = installDom();
+
+interface Posted {
+  url: string;
+  body: Record<string, unknown>;
+  key: string | null;
+}
+
+const posted: Posted[] = [];
+let route: (url: string, init?: RequestInit) => Response | Promise<Response> = () => jsonResponse({});
+
+installFetch((url, init) => {
+  if (url === '/api/runs' && init?.method === 'POST') {
+    posted.push({
+      url,
+      body: JSON.parse(String(init.body)) as Record<string, unknown>,
+      key: new Headers(init.headers).get('idempotency-key')
+    });
+  }
+  return route(url, init);
+});
+
+const main = await import('../client/main.js');
+const { state, submitResearch, handleAuthSuccess, clearPrivateState, renderAll } = main.__test;
+
+function makeView(runId: string, overrides: Partial<CanonicalView> = {}): CanonicalView {
+  const base: CanonicalView = {
+    schemaVersion: SCHEMA_VERSION,
+    runId,
+    state: 'queued',
+    revision: 1,
+    question: `问题 ${runId}`,
+    seedUrl: null,
+    provider: 'github',
+    parentRunId: null,
+    retryOf: null,
+    followup: false,
+    createdAt: '2024-01-01T00:00:00.000Z',
+    updatedAt: '2024-01-01T00:00:00.000Z',
+    interrupted: false,
+    stopReason: null,
+    identity: {
+      displayName: runId,
+      handle: null,
+      profileUrl: null,
+      status: 'resolved',
+      note: null,
+      candidates: []
+    },
+    sources: [],
+    observations: [],
+    answer: [],
+    limitations: [],
+    usage: { provider: 'github', requests: 0, bytes: 0, elapsedMs: 0, measurement: 'not_run' },
+    reviewCount: 0
+  };
+  return { ...base, ...overrides };
+}
+
+function freshUser(id: string): void {
+  state.user = { id, email: `${id}@example.test`, name: id };
+  state.run = null;
+  state.runs = [];
+  state.messages = [];
+  state.activeRunId = null;
+  state.submitAttempt = null;
+  state.submitRoleChoice = null;
+  state.submitCase = null;
+  state.pendingSubmit = false;
+  state.submitBusy = false;
+  renderAll();
+}
+
+async function settle(): Promise<void> {
+  for (let index = 0; index < 6; index += 1) await new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+function question(): HTMLTextAreaElement {
+  return env.document.getElementById('research-question') as HTMLTextAreaElement;
+}
+
+function consentBox(): HTMLInputElement {
+  return env.document.getElementById('email-consent') as HTMLInputElement;
+}
+
+function preview(): string {
+  return env.document.getElementById('input-preview')?.textContent ?? '';
+}
+
+function setBasis(value: string): void {
+  for (const radio of env.document.querySelectorAll<HTMLInputElement>('input[name="email-consent-basis"]')) {
+    radio.checked = radio.value === value;
+  }
+}
+
+function fire(type: string, target: HTMLElement = question()): void {
+  target.dispatchEvent(new env.window.Event(type, { bubbles: true, cancelable: true }));
+}
+
+function submitForm(): void {
+  env.document.getElementById('research-form')!.dispatchEvent(new env.window.Event('submit', { bubbles: true, cancelable: true }));
+}
+
+test('typing, paste, blur and preview send nothing and navigate nowhere', async () => {
+  freshUser('client-silent');
+  await settle();
+  const before = posted.length;
+  const streams = MockEventSource.instances.length;
+  const hash = window.location.hash;
+
+  question().value = 'A.B+Tag@Example.TEST';
+  fire('input');
+  fire('paste');
+  fire('change');
+  fire('blur');
+  question().value = 'https://github.com/fixture-owner';
+  fire('input');
+  fire('blur');
+  question().value = 'octo_fixture';
+  fire('input');
+  await settle();
+
+  assert.equal(posted.length, before, 'no request may leave the page before explicit submit');
+  assert.equal(MockEventSource.instances.length, streams, 'no stream may open while typing');
+  assert.equal(window.location.hash, hash, 'no navigation may happen while typing');
+  // The classification preview itself is local and redacts sensitive input.
+  question().value = 'A.B+Tag@Example.TEST';
+  fire('input');
+  const text = preview();
+  assert.ok(text.length > 0, 'preview is rendered locally');
+  assert.equal(text.includes('A.B+Tag'), false, 'preview must be redacted');
+  assert.equal(text.toLowerCase().includes('example.test'), false, 'preview must not echo the domain');
+  assert.equal(
+    (consentBox().closest('#email-consent-row') as HTMLElement | null)?.hidden,
+    false,
+    'consent row appears for emails'
+  );
+  assert.equal(posted.length, before);
+  assert.equal(MockEventSource.instances.length, streams);
+});
+
+test('explicit email submit requires scoped consent and only then posts', async () => {
+  freshUser('client-consent');
+  posted.length = 0;
+  route = (url, init) => {
+    if (url === '/api/runs' && init?.method === 'POST') {
+      return jsonResponse({
+        run: makeView('email-run', { state: 'needs_input' }),
+        idempotent: false,
+        input: { inputId: 'input_1', inputRevision: 1, kind: 'email', displayValue: 'A***@e***.test', status: 'unsupported_email' },
+        roleAmbiguity: [],
+        emailUnsupported: true,
+        queued: false,
+        caseId: 'case_1',
+        scopeVersion: 1
+      });
+    }
+    return jsonResponse({ runs: [] });
+  };
+
+  question().value = 'A.B+Tag@Example.TEST';
+  fire('input');
+  submitForm();
+  await settle();
+  assert.equal(posted.length, 0, 'an email without explicit consent never posts');
+  assert.match(env.document.getElementById('question-error')?.textContent ?? '', /授权/);
+
+  setBasis('consent_obtained');
+  consentBox().checked = true;
+  submitForm();
+  await settle();
+  assert.equal(posted.length, 1, 'explicit submit posts exactly once');
+  assert.equal(posted[0]!.body.input, 'A.B+Tag@Example.TEST');
+  assert.deepEqual(posted[0]!.body.emailConsent, { basis: 'consent_obtained' });
+  assert.ok(posted[0]!.key);
+
+  // Changing the input invalidates the earlier consent: no silent reuse.
+  question().value = 'other.person@example.test';
+  fire('input');
+  assert.equal(consentBox().checked, false, 'consent is bound to the typed input');
+  submitForm();
+  await settle();
+  assert.equal(posted.length, 1, 'a changed email cannot reuse the old consent');
+});
+
+test('the login callback auto-submit revalidates the current input and user', async () => {
+  freshUser('client-login');
+  posted.length = 0;
+  state.user = null;
+  route = (url, init) => {
+    if (url === '/api/runs' && init?.method === 'POST') {
+      return jsonResponse({
+        run: makeView('login-run'),
+        idempotent: false,
+        input: null,
+        roleAmbiguity: [],
+        emailUnsupported: false,
+        queued: true,
+        caseId: 'case_2',
+        scopeVersion: 2
+      });
+    }
+    return jsonResponse({ runs: [] });
+  };
+
+  question().value = 'A.B+Tag@Example.TEST';
+  fire('input');
+  consentBox().checked = true;
+  setBasis('self');
+  await submitResearch();
+  await settle();
+  assert.equal(posted.length, 0, 'nothing posts before login');
+
+  // The user edits the input before the login callback fires.
+  question().value = 'Research Ada Fixture';
+  fire('input');
+  await settle();
+  // The auth success callback installs the CURRENT user and re-invokes the
+  // submit path, which revalidates the CURRENT input, consent and user.
+  handleAuthSuccess({ id: 'client-login', email: 'client-login@example.test', name: 'login' });
+  await submitResearch();
+  await settle();
+  assert.equal(posted.length, 1, 'the auto-submit posts exactly once');
+  assert.equal(posted[0]!.body.input, 'Research Ada Fixture', 'the CURRENT input is submitted, not the stale one');
+  assert.equal(posted[0]!.body.emailConsent, undefined, 'stale consent is not attached');
+
+  // Without any user context nothing can submit.
+  state.user = null;
+  question().value = 'Research Ada Fixture 2';
+  fire('input');
+  await submitResearch();
+  await settle();
+  assert.equal(posted.length, 1, 'no submission happens without a session');
+});
+
+test('logout and account switches clear consent and typed input', async () => {
+  freshUser('client-switch');
+  posted.length = 0;
+  route = () => jsonResponse({ runs: [] });
+  question().value = 'A.B+Tag@Example.TEST';
+  fire('input');
+  consentBox().checked = true;
+  setBasis('self');
+  handleAuthSuccess({ id: 'client-other', email: 'other@example.test', name: 'other' });
+  await settle();
+  assert.equal(question().value, '', 'unsent input is dropped on an identity switch');
+  assert.equal(consentBox().checked, false, 'consent never survives an account switch');
+  clearPrivateState();
+  assert.equal(preview(), '');
+  assert.equal(posted.length, 0);
+});
+
+test('an ambiguous role stays visible and submits a confirmation bound to the input revision', async () => {
+  freshUser('client-role');
+  posted.length = 0;
+  let calls = 0;
+  route = (url, init) => {
+    if (url === '/api/runs' && init?.method === 'POST') {
+      calls += 1;
+      if (calls === 1) {
+        return jsonResponse({
+          run: makeView('role-run', { state: 'needs_input' }),
+          idempotent: false,
+          input: { inputId: 'input_role', inputRevision: 3, kind: 'url', displayValue: 'https://x.com/fixture_author/status/1', status: 'needs_role_confirmation' },
+          roleAmbiguity: [
+            {
+              code: 'publisher_subject_unresolved',
+              message: '发布者、受访者与研究对象不能只凭 URL 合并。',
+              options: ['select_resource_account', 'not_a_person_seed']
+            }
+          ],
+          emailUnsupported: false,
+          queued: false,
+          caseId: 'case_role',
+          scopeVersion: 1
+        });
+      }
+      return jsonResponse({
+        run: makeView('role-run-confirmed'),
+        idempotent: false,
+        input: { inputId: 'input_role', inputRevision: 4, kind: 'url', displayValue: 'https://x.com/fixture_author/status/1', status: 'accepted' },
+        roleAmbiguity: [],
+        emailUnsupported: false,
+        queued: true,
+        caseId: 'case_role',
+        scopeVersion: 2
+      });
+    }
+    return jsonResponse({ runs: [] });
+  };
+
+  question().value = 'https://x.com/fixture_author/status/1';
+  fire('input');
+  submitForm();
+  await settle();
+  assert.equal(posted.length, 1);
+  assert.equal(posted[0]!.body.roleChoice, undefined);
+  // The ambiguity is visible with explicit actions instead of a silent seed.
+  const actions = env.document.querySelectorAll<HTMLButtonElement>('#role-ambiguity-actions [data-role-choice]');
+  assert.equal(actions.length, 2);
+  assert.equal(env.document.getElementById('role-ambiguity')?.hidden, false);
+
+  actions[0]!.click();
+  await settle();
+  assert.equal(posted.length, 2, 'confirming the role resubmits exactly once');
+  assert.deepEqual(posted[1]!.body.roleChoice, {
+    choice: 'select_resource_account',
+    inputId: 'input_role',
+    inputRevision: 3
+  });
+  assert.equal(posted[1]!.body.caseId, 'case_role');
+  assert.equal(posted[1]!.body.expectedScopeVersion, 1);
+  assert.notEqual(posted[1]!.key, posted[0]!.key, 'a changed role uses a fresh idempotency key');
+});
+
+test('an unsafe URL never falls back into a generic submission', async () => {
+  freshUser('client-unsafe');
+  posted.length = 0;
+  question().value = 'javascript:alert(1)';
+  fire('input');
+  submitForm();
+  await settle();
+  assert.equal(posted.length, 0, 'an unsafe URL must not become a generic question');
+  assert.match(env.document.getElementById('question-error')?.textContent ?? '', /链接|http/);
+});
diff --git a/apps/web/src/tests/research-input.test.ts b/apps/web/src/tests/research-input.test.ts
new file mode 100644
index 0000000..5914109
--- /dev/null
+++ b/apps/web/src/tests/research-input.test.ts
@@ -0,0 +1,272 @@
+/**
+ * GET-62 unified input contract: pure local parsing and classification.
+ *
+ * Everything here runs offline: no fetch, no SDK, no navigation. The matrix
+ * covers personal profiles, posts, organization pages, articles/interviews,
+ * ambiguous roles, bare vs platform-qualified usernames, unsafe URLs and the
+ * email normalization / redaction rules.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import {
+  RESEARCH_INPUT_SCHEMA_VERSION,
+  classifyResearchInput,
+  containsEmailToken,
+  discoverySubjectClassification,
+  findEmailToken,
+  normalizeEmailValue,
+  redactEmailValue,
+  redactEmailsInText,
+  sanitizePublicValue,
+  toPublicInputView
+} from '../shared/research-input.js';
+import type { InputEnvelope, ResearchInputClassification } from '../shared/research-input.js';
+
+function classify(raw: string): ResearchInputClassification {
+  const result = classifyResearchInput(raw);
+  assert.equal(result.ok, true, `expected ${raw} to classify`);
+  if (!result.ok) throw new Error('unreachable');
+  return result.classification;
+}
+
+function reject(raw: string): { code: string } {
+  const result = classifyResearchInput(raw);
+  assert.equal(result.ok, false, `expected ${JSON.stringify(raw)} to be rejected`);
+  if (result.ok) throw new Error('unreachable');
+  return { code: result.code };
+}
+
+/* ------------------------------------------------------------------ */
+/* URL roles                                                          */
+/* ------------------------------------------------------------------ */
+
+test('a clear personal profile URL keeps the original URL and becomes an account seed', () => {
+  const c = classify('https://GitHub.com/Ada-Lovelace?utm_source=x');
+  assert.equal(c.kind, 'url');
+  assert.equal(c.originalValue, 'https://GitHub.com/Ada-Lovelace?utm_source=x');
+  // Original preserved verbatim on the anchor; normalized form is separate.
+  assert.equal(c.anchors[0]?.originalUrl, 'https://GitHub.com/Ada-Lovelace?utm_source=x');
+  assert.equal(c.normalizedValue, 'https://github.com/ada-lovelace');
+  assert.ok(c.accountSeed);
+  assert.equal(c.accountSeed?.platform, 'github');
+  assert.equal(c.accountSeed?.handle, 'Ada-Lovelace');
+  assert.equal(c.accountSeed?.basis, 'profile_url');
+  // GitHub /handle alone never proves person vs organization.
+  assert.equal(c.accountSeed?.accountRole, 'unknown');
+  assert.equal(c.intendedScope, 'account_only');
+  assert.equal(c.ambiguities.length, 0);
+});
+
+test('organization pages are organizations and never become person facts', () => {
+  const c = classify('https://github.com/orgs/stripsearch-fixture');
+  assert.equal(c.kind, 'url');
+  assert.equal(c.accountSeed?.accountRole, 'organization');
+  assert.equal(c.intendedScope, 'account_only');
+  assert.equal(c.ambiguities.length, 0);
+  assert.ok(c.notes.some((note) => note.includes('不产生自然人事实')));
+});
+
+test('post URLs keep resource ids and publisher clues and keep the role ambiguous', () => {
+  const x = classify('https://x.com/fixture_author/status/1789001234567890123');
+  assert.equal(x.kind, 'url');
+  const resource = x.anchors.find((anchor) => anchor.anchorRole === 'resource');
+  const publisher = x.anchors.find((anchor) => anchor.anchorRole === 'publisher');
+  assert.equal(resource?.resourceId, '1789001234567890123');
+  assert.equal(resource?.originalUrl, 'https://x.com/fixture_author/status/1789001234567890123');
+  assert.equal(publisher?.handle, 'fixture_author');
+  // Publisher is a clue only: the mentioned/interviewed subject is not merged.
+  assert.equal(x.anchors.some((anchor) => anchor.anchorRole === 'intended_subject'), false);
+  assert.equal(x.ambiguities.length, 1);
+  assert.equal(x.ambiguities[0]?.code, 'publisher_subject_unresolved');
+  assert.deepEqual(x.ambiguities[0]?.options, ['select_resource_account', 'not_a_person_seed']);
+  assert.equal(x.ambiguities[0]?.candidate?.handle, 'fixture_author');
+  assert.equal(x.ambiguities[0]?.candidate?.accountRole, 'unknown');
+  assert.equal(x.accountSeed, null);
+  assert.equal(x.intendedScope, 'resource_research');
+
+  const gh = classify('https://github.com/fixture-owner/fixture-repo/issues/42');
+  assert.equal(gh.ambiguities.length, 1);
+  assert.equal(gh.anchors.find((anchor) => anchor.anchorRole === 'resource')?.resourceId, 'fixture-owner/fixture-repo/issues/42');
+  assert.equal(gh.anchors.find((anchor) => anchor.anchorRole === 'publisher')?.handle, 'fixture-owner');
+
+  const reddit = classify('https://www.reddit.com/r/synthetic/comments/abc123/a_thread/');
+  assert.equal(reddit.ambiguities.length, 1);
+  assert.equal(reddit.anchors.find((anchor) => anchor.anchorRole === 'resource')?.resourceId, 'abc123');
+  // A community is not a selectable account: only the honest options remain.
+  assert.deepEqual(reddit.ambiguities[0]?.options, ['not_a_person_seed']);
+  assert.equal(reddit.ambiguities[0]?.candidate, null);
+});
+
+test('article and interview URLs keep author, publisher and subject separate', () => {
+  const c = classify('https://fixture-magazine.example.test/interviews/fixture-person');
+  assert.equal(c.kind, 'url');
+  assert.equal(c.anchors.some((anchor) => anchor.urlRole === 'article'), true);
+  assert.equal(c.anchors.find((anchor) => anchor.anchorRole === 'publisher')?.urlRole, 'site');
+  // Author / publisher / interviewee cannot be merged from a URL.
+  assert.equal(c.anchors.filter((anchor) => anchor.anchorRole === 'intended_subject').length, 0);
+  assert.equal(c.ambiguities.length, 1);
+  assert.equal(c.ambiguities[0]?.code, 'resource_role_unconfirmed');
+  assert.equal(c.accountSeed, null);
+  assert.equal(c.intendedScope, 'unresolved');
+});
+
+test('a site root keeps the unknown role visible', () => {
+  const c = classify('https://fixture-personal.example.test');
+  assert.equal(c.ambiguities.length, 1);
+  assert.equal(c.ambiguities[0]?.code, 'resource_role_unconfirmed');
+  assert.equal(c.intendedScope, 'unresolved');
+});
+
+/* ------------------------------------------------------------------ */
+/* Usernames                                                          */
+/* ------------------------------------------------------------------ */
+
+test('bare usernames stay clues: no platform, no profile, no person inference', () => {
+  const c = classify('octo_fixture');
+  assert.equal(c.kind, 'username_clue');
+  assert.equal(c.accountSeed, null);
+  assert.equal(c.anchors.length, 0);
+  assert.equal(c.intendedScope, 'unresolved');
+  assert.ok(c.notes.some((note) => note.includes('不推断平台')));
+});
+
+test('platform-qualified usernames create one platform-scoped account clue', () => {
+  const gh = classify('github:octo_fixture');
+  assert.equal(gh.kind, 'platform_username');
+  assert.equal(gh.accountSeed?.platform, 'github');
+  assert.equal(gh.accountSeed?.handle, 'octo_fixture');
+  assert.equal(gh.accountSeed?.profileUrl, 'https://github.com/octo_fixture');
+  assert.equal(gh.accountSeed?.basis, 'platform_username');
+  assert.equal(gh.accountSeed?.accountRole, 'unknown');
+
+  const x = classify('x:octo_fixture');
+  assert.equal(x.accountSeed?.platform, 'x');
+  assert.equal(x.accountSeed?.profileUrl, 'https://x.com/octo_fixture');
+  // Identical handles on different platforms are never merged.
+  assert.notEqual(gh.accountSeed?.platform, x.accountSeed?.platform);
+});
+
+test('ordinary names and questions are text, not usernames', () => {
+  assert.equal(classify('Research Ada Fixture').kind, 'text');
+  assert.equal(classify('林舟 合成创作者').kind, 'text');
+  assert.equal(classifyResearchInput('   ').ok, false);
+  // A colon does not make a platform-qualified username out of ordinary text.
+  assert.equal(classify('Note:hello').kind, 'text');
+});
+
+/* ------------------------------------------------------------------ */
+/* Unsafe URLs never fall back into generic requests                   */
+/* ------------------------------------------------------------------ */
+
+test('invalid, credential, private and unsafe URLs are rejected instead of becoming questions', () => {
+  assert.equal(reject('https://user:pass@fixture.example.test/a').code, 'unsafe_input_url');
+  assert.equal(reject('https://127.0.0.1/admin').code, 'unsafe_input_url');
+  assert.equal(reject('https://localhost/admin').code, 'unsafe_input_url');
+  assert.equal(reject('https://192.168.0.10/x').code, 'unsafe_input_url');
+  assert.equal(reject('javascript:alert(1)').code, 'unsafe_input_url');
+  assert.equal(reject('data:text/html,hi').code, 'unsafe_input_url');
+  assert.equal(reject('https://fixture.example.test/\u0007bad').code, 'invalid_input_url');
+  // A question that embeds an unsafe URL cannot fall back to a plain question.
+  assert.equal(reject('研究 javascript:alert(1) 这个对象').code, 'unsafe_input_url');
+});
+
+test('a question that merely mentions a URL stays a question but keeps the anchors', () => {
+  const c = classify('研究 https://github.com/fixture-owner/fixture-repo 的公开记录');
+  assert.equal(c.kind, 'text');
+  assert.equal(c.anchors.length > 0, true);
+  assert.equal(c.accountSeed, null, 'a mentioned URL never silently becomes a person seed');
+  assert.equal(c.ambiguities.length, 0);
+  assert.ok(c.notes.some((note) => note.includes('不当作已确认的人物主页')));
+});
+
+/* ------------------------------------------------------------------ */
+/* Email normalization and redaction (sensitive)                       */
+/* ------------------------------------------------------------------ */
+
+test('email normalization preserves the local part and normalizes only the domain', () => {
+  assert.equal(normalizeEmailValue('A.B+Tag@Example.TEST'), 'A.B+Tag@example.test');
+  assert.equal(normalizeEmailValue('  First.Last+news@Sub.Example.Test.  '), 'First.Last+news@sub.example.test');
+  assert.equal(normalizeEmailValue('dot.user@EXAMPLE.test'), 'dot.user@example.test');
+  assert.equal(normalizeEmailValue('not-an-email'), null);
+  // No vendor-specific transforms: dots and +tag survive untouched and no
+  // username is derived from the local part.
+  const normalized = normalizeEmailValue('A.B+Tag@Example.TEST')!;
+  assert.equal(normalized, 'A.B+Tag@example.test');
+  assert.equal(normalized.split('@')[0], 'A.B+Tag');
+});
+
+test('email inputs are classified as sensitive with a redacted display value', () => {
+  const c = classify('A.B+Tag@Example.TEST');
+  assert.equal(c.kind, 'email');
+  assert.equal(c.sensitive, true);
+  assert.equal(c.normalizedValue, 'A.B+Tag@example.test');
+  assert.equal(c.displayValue.includes('A.B+Tag'), false);
+  assert.equal(c.displayValue.includes('example.test'), false);
+  // Any email token inside a question marks the whole input as email lineage.
+  const embedded = classify('请研究 A.B+Tag@Example.TEST 的公开活动');
+  assert.equal(embedded.kind, 'email');
+  assert.equal(embedded.normalizedValue, 'A.B+Tag@example.test');
+  assert.equal(containsEmailToken('没有邮箱的普通问题'), false);
+  assert.equal(findEmailToken('联系 a@b.test 或 c@d.test'), 'a@b.test');
+});
+
+test('redaction never echoes the raw email or a hash of it', () => {
+  const email = 'A.B+Tag@Example.TEST';
+  const raw = '研究 A.B+Tag@Example.TEST 的公开账号';
+  const redacted = redactEmailsInText(raw);
+  assert.equal(redacted.includes('A.B+Tag'), false);
+  assert.equal(redacted.toLowerCase().includes('example.test'), false);
+  assert.equal(redacted.includes(createHash('sha256').update('A.B+Tag@example.test').digest('hex')), false);
+  // Redaction is stable: redacting twice cannot grow the mask.
+  assert.equal(redactEmailsInText(redacted), redacted);
+  const view = redactEmailValue('Person@Example.TEST');
+  assert.equal(view.includes('Person'), false);
+  assert.equal(view.toLowerCase().includes('example.test'), false);
+  // Deep sanitization covers nested DTOs and arrays.
+  const sanitized = sanitizePublicValue({ a: ['x A.B+Tag@Example.TEST y'], b: { c: 'Person@Example.TEST' } }) as {
+    a: string[];
+    b: { c: string };
+  };
+  assert.equal(JSON.stringify(sanitized).includes('A.B+Tag'), false);
+  assert.equal(JSON.stringify(sanitized).includes('Person@Example.TEST'), false);
+});
+
+test('the public input view carries no raw or hashed email', () => {
+  const classification = classify('A.B+Tag@Example.TEST');
+  const envelope: InputEnvelope = {
+    inputId: 'input_test',
+    kind: classification.kind,
+    normalizedValue: classification.normalizedValue,
+    displayValue: classification.displayValue,
+    anchors: classification.anchors,
+    intendedScope: classification.intendedScope,
+    ownerId: 'user_test',
+    authorizationRef: 'authz_test',
+    inputRevision: 3,
+    status: 'unsupported_email',
+    classification,
+    createdAt: '2026-09-30T00:00:00.000Z'
+  };
+  const view = toPublicInputView(envelope);
+  const text = JSON.stringify(view);
+  assert.equal(text.includes('A.B+Tag'), false);
+  assert.equal(text.toLowerCase().includes('example.test'), false);
+  assert.equal(text.includes(createHash('sha256').update('A.B+Tag@example.test').digest('hex')), false);
+  assert.equal(view.inputId, 'input_test');
+  assert.equal(view.inputRevision, 3);
+  assert.equal(view.status, 'unsupported_email');
+  assert.equal(RESEARCH_INPUT_SCHEMA_VERSION, 'stripsearch/research-input/v1');
+});
+
+test('discovery subject classification keeps usernames as clues and emails sensitive', () => {
+  const username = discoverySubjectClassification('username', 'alice');
+  assert.equal(username.kind, 'username_clue');
+  assert.equal(username.sensitive, false);
+  const email = discoverySubjectClassification('email', 'Person@Example.TEST');
+  assert.equal(email.kind, 'email');
+  assert.equal(email.sensitive, true);
+  assert.equal(email.normalizedValue, 'Person@example.test');
+  assert.equal(email.displayValue.includes('Person'), false);
+});
diff --git a/docs/research-input-domain.md b/docs/research-input-domain.md
new file mode 100644
index 0000000..570fdff
--- /dev/null
+++ b/docs/research-input-domain.md
@@ -0,0 +1,47 @@
+# 统一研究输入契约（GET-62）
+
+状态：2026-09-30 落地。共享契约是 [`apps/web/src/shared/research-input.ts`](../apps/web/src/shared/research-input.ts)（`stripsearch/research-input/v1`）：`InputEnvelope`（`inputId, kind, normalizedValue, anchors, intendedScope, ownerId, authorizationRef?, inputRevision`）、本地纯解析/分类、邮箱规范化与脱敏、公开 DTO 投影。范围绑定沿用 [GET-58 研究案例领域契约](research-case-domain.md) 的 `ResearchCase / ScopeVersion / AccountSelection / RecordProvenance` 与 `Store.cases` 原子范围路径；没有第二套 scope/owner/account 类型，也没有并行身份体系。
+
+**这是输入与范围接入，不是新运行时。** 未实现 GET-66 邮箱公开匹配、GET-79 租约/持久调度，也没有启用 Search / Fetch 运行时；现有 Web alpha 的研究行为保持不变。
+
+## 实际接入的入口
+
+| 入口 | 行为 |
+| --- | --- |
+| `POST /api/runs`（`client/main.ts` 提交表单 → `ApiClient.createResearch`） | 服务器复验本地分类 → 一个事务写入输入修订（+邮箱授权记录）+ 案例/账号范围变更 + run + 输入绑定 + 幂等键；提交成功后才 `runner.enqueue`（fire-and-forget，不声称 worker 已开始） |
+| `POST /api/runs/:id/resume` | 事务内产生新输入修订 + 范围推进（对象变更），提交后排队；邮箱流程没有 checkpoint 也能补充公开主页（不伪造 checkpoint） |
+| `POST /api/runs/:id/retry`、`/followup` | 继续旧对象时保留原输入绑定；含邮箱线索的问题/旧研究被拒绝进入通用 planner |
+| `POST /api/discovery/tasks` | 同一事务写入输入修订 + 发现任务绑定 + 幂等键；邮箱主题需 self/consent 授权，且保持 `needs_input`/unsupported、永不排队 |
+| `client/main.ts` 输入框 | 本地分类预览（脱敏）、邮箱授权勾选、角色确认按钮；键入/粘贴/失焦/预览零请求、零遥测、零导航 |
+
+## 输入分类与角色
+
+- 完整 URL 保留原 URL 与资源 ID，区分个人主页 / 帖子 / 组织页 / 文章 / 未知；发布者、受访者与研究对象是不同锚点，绝不因 URL 合并。
+- GitHub `/handle` 只证明账号存在：个人/组织保持 `unknown`，不产生自然人事实；组织页标注 `organization`。
+- 平台限定用户名（如 `github:octo`）只按平台规则建立账号线索，不跨平台合并；裸用户名只是线索，不推断平台、主页或身份；普通姓名/问题仍是文本，不误判为用户名。
+- 无效、凭据、私网、本地地址与非 http(s) 链接一律拒绝，不回退成可外发的普通问题。
+- 明确种子（个人/组织账号页、平台限定用户名、用户确认的角色选择）经 GET-58 `applyScopeChange` 直接成为 `userSelection.selected` 账号范围；`identitySupport` 保持 `proposed`，不宣称跨平台同一人。
+- 资源/发布者角色不明时保留歧义：run 停在 `needs_input` 并给出确认载荷（绑定服务端当前 inputId/inputRevision），确认后才选定账号范围，且身份不升级；`not_a_person_seed` 则只作资料链接。
+
+## 邮箱边界
+
+- 规范化保留 local part（大小写、点号、`+tag`），只按通用规则规范域名（小写、去尾点）；不猜测用户名，不做 Gmail/Gravatar 类转换。认证邮箱行为不变。
+- 邮箱属敏感值：内部表保存原文（受 owner 权限保护，供未来 GET-66 使用），公开 DTO、预览、任务/运行摘要、事件/SSE、报告/导出、错误与日志只出现脱敏值，散列也算敏感不外发。
+- 需要明确的本人/已获同意授权记录（actor + owner + 归一化值 + 输入修订），服务端解析授权引用；`public_professional` 不构成邮箱授权。改变邮箱、改输入、登出/换账号都会使先前勾选/引用失效。
+- 提交前（键入/粘贴/失焦/预览）零请求、零遥测、零 provider；明确提交只向本应用 POST。
+- **GET-66 未实现**：授权邮箱诚实存储为 `unsupported_email` + `needs_input`，绝不排队，零外部匹配调用，无用户名回退、无“没有账号”结论；补公开主页后走原子的新输入/范围版本并恢复正常非邮箱调度。
+
+## 版本、幂等与事务语义
+
+- `inputRevision` 与权威 `scopeVersion` 分开：对象变更同时推进两者（新案例行从 v1 开始），旧输入/范围历史跨重开可读，stale/跨 owner 上下文拒绝。
+- 幂等指纹含 case/期望版本/输入修订/角色选择/授权绑定/规范输入与研究参数：同键重放在范围继续变化后仍返回原记录且不重复执行或重复授权；改角色/授权复用旧键明确冲突；跨 owner 键拒绝。
+- 提交是单事务：合法第一引用 + 外来第二引用失败时，input/授权/范围 journal/账号/run/绑定/事件/幂等键全量回滚，队列收到零任务。
+- 提交前失败（全量回滚、队列 0）与提交后失败（响应丢失或排队触发失败）分开：后者保留同一持久 run 与幂等记录，重试返回同一记录、不重复推进范围。GET-62 不引入 outbox、exactly-once 或新调度器；GET-79 负责租约/持久调度/重启发布。
+
+## 遗留数据
+
+旧 runs/discovery 行不做破坏性改写：读时脱敏保护 `taskSummary`、创建事件与 run 摘要/事件/导出；内部原文保留。旧报告保持可读；现有非邮箱 Web alpha 流程不变。
+
+## 验证
+
+`apps/web/src/tests/research-input.test.ts`（纯解析/角色矩阵/邮箱规范化与脱敏）、`research-input-api.test.ts`（真实 UI→API→Store/队列组合、授权、角色确认、幂等、pre/post-commit、回滚、跨重开）、`research-input-client.test.ts`（输入零外发、脱敏预览、授权门槛、登录回调重校验、角色确认载荷）。全部离线，provider 为 fake/拒绝；静态检查 `python3 scripts/check_design.py` 不验证运行时行为。
