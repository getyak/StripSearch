+        ownerId,
+        caseId: caseRecord.caseId,
+        expectedScopeVersion: caseRecord.scopeVersion,
+        reason: 'input_account_selected',
+        accounts: existing
+          ? [
+              {
+                accountId: existing.accountId,
+                userSelection: draft.userSelection,
+                allowedScope: draft.allowedScope
+              }
+            ]
+          : [{ create: draft }]
+      });
