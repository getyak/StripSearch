new file mode 100644
index 0000000..86ba03c
--- /dev/null
+++ b/apps/web/src/server/research/input-store.ts
@@ -0,0 +1,408 @@
+/**
+ * GET-62 unified research input persistence (same SQLite lifetime as
+ * `Store.cases`). Append-only input revisions, explicit subject-email
+ * authorization records and run/discovery input bindings.
+ *
+ * Privacy: `internal_value` keeps the owner-private original (needed so an
+ * authorized email can later be matched by GET-66); every read that leaves the
+ * server goes through the public DTO which never carries a raw or hashed
+ * email. Nothing here invents consent: authorization rows are only written for
+ * explicit self/consent statements bound to actor + owner + input revision +
+ * normalized value.
+ */
+
+import { randomUUID } from 'node:crypto';
+import type { DB } from '../db/index.js';
+import type {
+  InputEnvelope,
+  InputStatus,
+  IntendedScope,
+  PublicInputView,
+  ResearchInputClassification,
+  ResearchInputKind
+} from '../../shared/research-input.js';
+import { redactEmailValue, toPublicInputView } from '../../shared/research-input.js';
+
+function nowIso(): string {
+  return new Date().toISOString();
+}
+
+function newRecordId(prefix: string): string {
+  return `${prefix}_${randomUUID().replace(/-/g, '').slice(0, 24)}`;
+}
+
+export type InputAuthorizationBasis = 'self' | 'consent_obtained';
+
+export interface InputRevisionDraft {
+  ownerId: string;
+  caseId: string;
+  classification: ResearchInputClassification;
+  status: InputStatus;
+  /** Stable line id; generated when this is the first revision. */
+  inputId?: string;
+}
+
+export interface InputRevisionRecord {
+  inputId: string;
+  revision: number;
+  ownerId: string;
+  caseId: string;
+  kind: ResearchInputKind;
+  internalValue: string;
+  normalizedValue: string;
+  displayValue: string;
+  sensitive: boolean;
+  intendedScope: IntendedScope;
+  status: InputStatus;
+  classification: ResearchInputClassification;
+  createdAt: string;
+}
+
+export interface InputAuthorizationRecord {
+  id: string;
+  ownerId: string;
+  caseId: string;
+  inputId: string;
+  inputRevision: number;
+  subjectKind: 'email';
+  normalizedValue: string;
+  actorId: string;
+  basis: InputAuthorizationBasis;
+  createdAt: string;
+}
+
+export interface InputBindingRecord {
+  id: string;
+  inputId: string;
+  inputRevision: number;
+  caseId: string;
+  runId: string | null;
+  discoveryTaskId: string | null;
+  createdAt: string;
+}
+
+interface InputRow {
+  input_id: string;
+  revision: number;
+  owner_id: string;
+  case_id: string;
+  kind: ResearchInputKind;
+  internal_value: string;
+  normalized_value: string;
+  display_value: string;
+  sensitive: number;
+  intended_scope: IntendedScope;
+  status: InputStatus;
+  classification_json: string;
+  created_at: string;
+}
+
+function parseJson<T>(raw: string, fallback: T): T {
+  try {
+    return JSON.parse(raw) as T;
+  } catch {
+    return fallback;
+  }
+}
+
+function mapInput(row: InputRow): InputRevisionRecord {
+  return {
+    inputId: row.input_id,
+    revision: row.revision,
+    ownerId: row.owner_id,
+    caseId: row.case_id,
+    kind: row.kind,
+    internalValue: row.internal_value,
+    normalizedValue: row.normalized_value,
+    displayValue: row.display_value,
+    sensitive: row.sensitive === 1,
+    intendedScope: row.intended_scope,
+    status: row.status,
+    classification: parseJson<ResearchInputClassification>(row.classification_json, {
+      kind: row.kind,
+      originalValue: row.internal_value,
+      normalizedValue: row.normalized_value,
+      displayValue: row.display_value,
+      sensitive: row.sensitive === 1,
+      anchors: [],
+      accountSeed: null,
+      ambiguities: [],
+      intendedScope: row.intended_scope,
+      notes: []
+    }),
+    createdAt: row.created_at
+  };
+}
+
+export class InputNotFoundError extends Error {
+  constructor(readonly inputId: string) {
+    super(`input ${inputId} not found`);
+    this.name = 'InputNotFoundError';
+  }
+}
+
+export class InputAuthorizationError extends Error {
+  constructor(readonly code: string, readonly detail: string) {
+    super(detail);
+    this.name = 'InputAuthorizationError';
+  }
+}
+
+export class ResearchInputStore {
+  constructor(private readonly db: DB) {}
+
+  /** Single transaction boundary callers use to compose atomic submissions. */
+  transaction<T>(fn: () => T): T {
+    return this.db.transaction(fn)();
+  }
+
+  recordRevision(draft: InputRevisionDraft): InputRevisionRecord {
+    const inputId = draft.inputId ?? newRecordId('input');
+    const next = draft.inputId
+      ? ((
+          this.db
+            .prepare('SELECT COALESCE(MAX(revision), 0) + 1 AS n FROM research_inputs WHERE input_id = ?')
+            .get(inputId) as { n: number }
+        ).n)
+      : 1;
+    const classification = draft.classification;
+    const sensitive = classification.kind === 'email';
+    this.db
+      .prepare(
+        `INSERT INTO research_inputs (
+          input_id, revision, owner_id, case_id, kind, internal_value, normalized_value,
+          display_value, sensitive, intended_scope, status, classification_json, created_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
+      )
+      .run(
+        inputId,
+        next,
+        draft.ownerId,
+        draft.caseId,
+        classification.kind,
+        classification.originalValue,
+        classification.normalizedValue,
+        sensitive ? redactEmailValue(classification.normalizedValue) : classification.displayValue,
+        sensitive ? 1 : 0,
+        classification.intendedScope,
+        draft.status,
+        JSON.stringify(classification),
+        nowIso()
+      );
+    return this.getRevision(draft.ownerId, inputId, next)!;
+  }
+
+  getRevision(ownerId: string, inputId: string, revision: number): InputRevisionRecord | null {
+    const row = this.db
+      .prepare('SELECT * FROM research_inputs WHERE input_id = ? AND revision = ? AND owner_id = ?')
+      .get(inputId, revision, ownerId) as InputRow | undefined;
+    return row ? mapInput(row) : null;
+  }
+
+  latestRevision(ownerId: string, inputId: string): InputRevisionRecord | null {
+    const row = this.db
+      .prepare(
+        'SELECT * FROM research_inputs WHERE input_id = ? AND owner_id = ? ORDER BY revision DESC LIMIT 1'
+      )
+      .get(inputId, ownerId) as InputRow | undefined;
+    return row ? mapInput(row) : null;
+  }
+
+  listRevisions(ownerId: string, inputId: string): InputRevisionRecord[] {
+    const rows = this.db
+      .prepare('SELECT * FROM research_inputs WHERE input_id = ? AND owner_id = ? ORDER BY revision ASC')
+      .all(inputId, ownerId) as InputRow[];
+    return rows.map(mapInput);
+  }
+
+  listCaseInputs(ownerId: string, caseId: string): InputRevisionRecord[] {
+    const rows = this.db
+      .prepare('SELECT * FROM research_inputs WHERE case_id = ? AND owner_id = ? ORDER BY created_at, revision')
+      .all(caseId, ownerId) as InputRow[];
+    return rows.map(mapInput);
+  }
+
+  recordAuthorization(input: {
+    ownerId: string;
+    caseId: string;
+    inputId: string;
+    inputRevision: number;
+    normalizedValue: string;
+    actorId: string;
+    basis: InputAuthorizationBasis;
+  }): InputAuthorizationRecord {
+    const id = newRecordId('authz');
+    this.db
+      .prepare(
+        `INSERT INTO research_input_authorizations (
+          id, owner_id, case_id, input_id, input_revision, subject_kind,
+          normalized_value, actor_id, basis, created_at
+        ) VALUES (?, ?, ?, ?, ?, 'email', ?, ?, ?, ?)`
+      )
+      .run(
+        id,
+        input.ownerId,
+        input.caseId,
+        input.inputId,
+        input.inputRevision,
+        input.normalizedValue,
+        input.actorId,
+        input.basis,
+        nowIso()
+      );
+    return this.getAuthorization(input.ownerId, id)!;
+  }
+
+  getAuthorization(ownerId: string, id: string): InputAuthorizationRecord | null {
+    const row = this.db
+      .prepare('SELECT * FROM research_input_authorizations WHERE id = ? AND owner_id = ?')
+      .get(id, ownerId) as
+      | {
+          id: string;
+          owner_id: string;
+          case_id: string;
+          input_id: string;
+          input_revision: number;
+          subject_kind: 'email';
+          normalized_value: string;
+          actor_id: string;
+          basis: InputAuthorizationBasis;
+          created_at: string;
+        }
+      | undefined;
+    if (!row) return null;
+    return {
+      id: row.id,
+      ownerId: row.owner_id,
+      caseId: row.case_id,
+      inputId: row.input_id,
+      inputRevision: row.input_revision,
+      subjectKind: row.subject_kind,
+      normalizedValue: row.normalized_value,
+      actorId: row.actor_id,
+      basis: row.basis,
+      createdAt: row.created_at
+    };
+  }
+
+  /**
+   * Server-side authorization resolution. A reference is only valid when the
+   * row exists for this owner, was recorded by the current actor and binds the
+   * same normalized value + input revision; arbitrary strings and generic
+   * provenance labels are never accepted.
+   */
+  resolveAuthorization(
+    ownerId: string,
+    actorId: string,
+    ref: string,
+    expect: { normalizedValue: string; inputRevision: number }
+  ): InputAuthorizationRecord {
+    const record = this.getAuthorization(ownerId, ref);
+    if (!record) {
+      throw new InputAuthorizationError('authorization_not_found', '授权记录不存在或不属于当前账号。');
+    }
+    if (record.actorId !== actorId || record.ownerId !== ownerId) {
+      throw new InputAuthorizationError('authorization_foreign', '授权记录不属于当前用户。');
+    }
+    if (record.normalizedValue !== expect.normalizedValue) {
+      throw new InputAuthorizationError('authorization_value_mismatch', '授权记录对应的邮箱与本次提交不一致。');
+    }
+    if (record.inputRevision !== expect.inputRevision) {
+      throw new InputAuthorizationError('authorization_stale', '授权记录对应的输入版本已过期，请重新确认。');
+    }
+    return record;
+  }
+
+  bind(input: {
+    inputId: string;
+    inputRevision: number;
+    caseId: string;
+    runId?: string | null;
+    discoveryTaskId?: string | null;
+  }): InputBindingRecord {
+    const id = newRecordId('bind');
+    this.db
+      .prepare(
+        `INSERT INTO research_input_bindings (id, input_id, input_revision, case_id, run_id, discovery_task_id, created_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`
+      )
+      .run(id, input.inputId, input.inputRevision, input.caseId, input.runId ?? null, input.discoveryTaskId ?? null, nowIso());
+    return {
+      id,
+      inputId: input.inputId,
+      inputRevision: input.inputRevision,
+      caseId: input.caseId,
+      runId: input.runId ?? null,
+      discoveryTaskId: input.discoveryTaskId ?? null,
+      createdAt: nowIso()
+    };
+  }
+
+  private mapBinding(row: {
+    id: string;
+    input_id: string;
+    input_revision: number;
+    case_id: string;
+    run_id: string | null;
+    discovery_task_id: string | null;
+    created_at: string;
+  }): InputBindingRecord {
+    return {
+      id: row.id,
+      inputId: row.input_id,
+      inputRevision: row.input_revision,
+      caseId: row.case_id,
+      runId: row.run_id,
+      discoveryTaskId: row.discovery_task_id,
+      createdAt: row.created_at
+    };
+  }
+
+  bindingForRun(runId: string): InputBindingRecord | null {
+    const row = this.db
+      .prepare('SELECT * FROM research_input_bindings WHERE run_id = ?')
+      .get(runId) as Parameters<ResearchInputStore['mapBinding']>[0] | undefined;
+    return row ? this.mapBinding(row) : null;
+  }
+
+  /** Move a run's binding to a newer input revision (same input line). */
+  rebindRun(runId: string, inputId: string, inputRevision: number): void {
+    this.db
+      .prepare('UPDATE research_input_bindings SET input_id = ?, input_revision = ? WHERE run_id = ?')
+      .run(inputId, inputRevision, runId);
+  }
+
+  bindingForDiscoveryTask(taskId: string): InputBindingRecord | null {
+    const row = this.db
+      .prepare('SELECT * FROM research_input_bindings WHERE discovery_task_id = ?')
+      .get(taskId) as Parameters<ResearchInputStore['mapBinding']>[0] | undefined;
+    return row ? this.mapBinding(row) : null;
+  }
+
+  /** Envelope for a bound run/task: the exact bound input revision. */
+  envelopeForBinding(ownerId: string, binding: InputBindingRecord): InputEnvelope | null {
+    const record = this.getRevision(ownerId, binding.inputId, binding.inputRevision);
+    return record ? toEnvelope(record) : null;
+  }
+
+  publicView(record: InputRevisionRecord): PublicInputView {
+    return toPublicInputView(toEnvelope(record));
+  }
+}
+
+export function toEnvelope(record: InputRevisionRecord, authorizationRef: string | null = null): InputEnvelope {
+  return {
+    inputId: record.inputId,
+    kind: record.kind,
+    normalizedValue: record.normalizedValue,
+    displayValue: record.displayValue,
+    anchors: record.classification.anchors,
+    intendedScope: record.intendedScope,
+    ownerId: record.ownerId,
+    authorizationRef,
+    inputRevision: record.revision,
+    status: record.status,
+    classification: record.classification,
+    createdAt: record.createdAt
+  };
+}
