+}
+
+export interface ResumeInputRequest {
+  ownerId: string;
+  runId: string;
+  seedUrl: string | null;
+  candidateId: string | null;
+  roleChoice: RoleChoiceRequest | null;
+}
+
+export interface ResumeInputResult {
+  kind: 'resumed';
+  run: RunRecord;
+  input: PublicInputView | null;
+  caseId: string | null;
+  scopeVersion: ScopeVersion | null;
+}
+
+/** Resume kept the role ambiguity visible: nothing was written or scheduled. */
+export interface ResumeRoleAmbiguity {
+  kind: 'role_ambiguous';
+  ambiguities: RoleAmbiguity[];
+  input: PublicInputView | null;
+}
+
+export type ResumeOutcome = ResumeInputResult | ResumeRoleAmbiguity | 'not_found' | 'conflict';
+
+const IDENTITY_POLICY_VERSION = RESEARCH_INPUT_SCHEMA_VERSION;
+
+function nowIso(): string {
+  return new Date().toISOString();
+}
+
+function needsInputIdentity(note: string): IdentityDraft {
+  return {
+    displayName: '',
+    handle: null,
+    profileUrl: null,
+    status: 'needs_input',
+    note,
+    candidates: []
+  };
+}
+
+/** Semantic identity of a submission for the idempotency fingerprint. */
+export function submissionSemantic(input: {
+  classification: ResearchInputClassification;
+  caseId: string | null;
+  expectedScopeVersion: number | null;
+  roleChoice: RoleChoiceRequest | null;
+  emailConsent: EmailConsentRequest | null;
+}): Record<string, unknown> {
+  return {
+    inputKind: input.classification.kind,
+    normalizedInput: input.classification.normalizedValue,
+    caseId: input.caseId,
+    expectedScopeVersion: input.expectedScopeVersion,
+    roleChoice: input.roleChoice
+      ? {
+          choice: input.roleChoice.choice,
+          inputId: input.roleChoice.inputId ?? null,
+          inputRevision: input.roleChoice.inputRevision ?? null
+        }
+      : null,
+    authorization: input.emailConsent
+      ? 'authorizationRef' in input.emailConsent
+        ? { ref: input.emailConsent.authorizationRef }
+        : { basis: input.emailConsent.basis }
+      : null
+  };
+}
+
+export class ResearchInputService {
+  constructor(private readonly store: Store) {}
+
+  /* ---------------------------------------------------------------- */
+  /* Classification helpers (pure, reused by routes for fingerprints) */
+  /* ---------------------------------------------------------------- */
+
+  classify(text: string): ResearchInputClassification {
+    const result = classifyResearchInput(text);
+    if (!result.ok) {
+      throw new HttpError(
+        400,
+        result.code === 'unsafe_input_url' ? 'unsafe_input_url' : 'invalid_input_url',
+        result.error
+      );
+    }
+    return result.classification;
+  }
+
+  /** Merge the legacy explicit seed URL into the input classification. */
+  effectiveClassification(text: string, legacySeedUrl: string | null): ResearchInputClassification {
+    const base = this.classify(text);
+    if (!legacySeedUrl) return base;
+    const seedCheck = validateSeedUrl(legacySeedUrl);
+    if (!seedCheck.ok || !seedCheck.url) {
+      throw new HttpError(400, 'invalid_seed_url', seedCheck.error ?? '主页链接无效。');
+    }
+    const seedClass = this.classify(seedCheck.url);
+    return {
+      ...base,
+      anchors: [...seedClass.anchors, ...base.anchors],
+      accountSeed: seedClass.accountSeed ?? base.accountSeed,
+      ambiguities: seedClass.ambiguities,
+      intendedScope:
+        seedClass.intendedScope === 'unresolved' ? base.intendedScope : seedClass.intendedScope,
+      notes: [...seedClass.notes, ...base.notes]
+    };
+  }
+
+  /** Whether this classification still waits for a role confirmation. */
+  needsRoleConfirmation(classification: ResearchInputClassification, roleChoice: RoleChoiceRequest | null): boolean {
+    return classification.ambiguities.length > 0 && roleChoice === null;
+  }
+
+  /* ---------------------------------------------------------------- */
+  /* Submission                                                        */
+  /* ---------------------------------------------------------------- */
+
+  submit(request: SubmitInputRequest): SubmitInputResult {
+    const ownerId = request.ownerId;
+    const base = this.effectiveClassification(request.text, request.legacySeedUrl);
+    const screen = screenQuestion(request.text, request.legacySeedUrl ?? '');
+    if (screen.disallowed) {
+      throw new HttpError(422, 'scope_disallowed', screen.reason ?? '该请求不在可处理范围内。');
+    }
+    const isEmail = base.kind === 'email';
+    const needsRole = this.needsRoleConfirmation(base, request.roleChoice);
