+test('email consent binds actor, value and input revision; foreign or forged references reject', async (t) => {
+  const transport = new DenyTransport();
+  const server = await startTestServer({ providerFactory: createFakeFactory(), transport }, {}, {});
+  t.after(() => server.close());
+  await server.client.signUp('email-consent@example.test');
+  const foreign = new TestClient(server.baseUrl, server.origin);
+  await foreign.signUp('email-consent-foreign@example.test');
+
+  const first = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: EMAIL_RAW, emailConsent: { basis: 'self' } }
+  });
+  assert.equal(first.status, 201);
+  const authRow = server.boot.db
+    .prepare('SELECT id FROM research_input_authorizations WHERE owner_id = ?')
+    .get((await currentUser(server.client)).id) as { id: string };
+
+  // Changing the email value invalidates the earlier consent reference.
+  const changed = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: { input: 'other.person@example.test', emailConsent: { authorizationRef: authRow.id } }
+  });
+  assert.equal(changed.status, 403);
+  assert.equal(changed.body.error.code, 'authorization_value_mismatch');
+  // Another owner cannot reference it at all.
+  const stolen = await foreign.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: { input: EMAIL_RAW, emailConsent: { authorizationRef: authRow.id } }
+  });
+  assert.equal(stolen.status, 403);
+  // An arbitrary provenance string is never accepted as authorization.
+  const forged = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: { input: EMAIL_RAW, emailConsent: { authorizationRef: 'RecordProvenance:user_confirmed' } }
+  });
+  assert.equal(forged.status, 403);
+  assert.equal(forged.body.error.code, 'authorization_not_found');
+  assert.equal(transport.calls.length, 0);
+});
