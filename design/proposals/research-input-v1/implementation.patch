+    }
+    const isNewLine = caseRecord.scopeVersion === 1 && revision.revision === 1 && !viaRoleChoice;
+    if (isNewLine) {
+      // Brand-new case line: the creation journal is the first scope version.
+      return caseRecord.scopeVersion;
+    }
+    const result = this.store.cases.applyCaseScopeMutation({
+      ownerId,
+      caseId: caseRecord.caseId,
+      expectedScopeVersion: caseRecord.scopeVersion,
+      reason: 'input_subject_changed',
+      advance: true
+    });
+    return result.case.scopeVersion;
+  }
+
+  private runSeedUrl(
+    classification: ResearchInputClassification,
+    legacySeedUrl: string | null,
+    provider: ProviderName
+  ): { seed: string | null; candidate: string | null } {
+    const candidate =
+      legacySeedUrl ??
+      (classification.kind === 'url'
+        ? classification.normalizedValue
+        : extractResearchUrl(classification.originalValue));
+    if (!candidate) return { seed: null, candidate: null };
+    if (provider === 'research') return { seed: normalizeResearchUrl(candidate), candidate };
+    const checked = validateSeedUrl(candidate);
+    return { seed: checked.ok ? checked.url : null, candidate };
+  }
+
+  /* ---------------------------------------------------------------- */
+  /* Resume / subject fallback                                         */
+  /* ---------------------------------------------------------------- */
+
+  /**
+   * Transactional part of resume only; the caller enqueues post-commit.
+   * Supplying a subject on a bound run is a real object change: it appends a
+   * new input revision and advances the authoritative scope version; the run
+   * keeps its identity and history. A legacy unbound run keeps the historical
+   * behavior (including the research checkpoint requirement).
+   */
+  resume(request: ResumeInputRequest): ResumeOutcome {
+    const { ownerId, runId } = request;
+    return this.store.inputs.transaction(() => {
+      const run = this.store.getRunForOwner(runId, ownerId);
+      if (!run) return 'not_found' as const;
+      if (run.state !== 'needs_input') return 'conflict' as const;
+
+      const checkpoint = this.store.research.checkpoint(runId);
+      const binding = this.store.inputs.bindingForRun(runId);
+      if (!binding && run.provider === 'research' && !checkpoint) {
+        // Legacy behavior: a research run without a checkpoint cannot resume.
+        return 'conflict' as const;
+      }
+
+      // Resolve the subject URL exactly as the legacy routes did.
+      let seedUrl: string | null = null;
+      if (run.provider === 'research') {
+        const candidates = checkpoint?.candidates ?? [];
+        if (request.candidateId) {
+          seedUrl = candidates.find((candidate) => candidate.candidateId === request.candidateId)?.profileUrl ?? null;
+          if (!seedUrl) throw new HttpError(400, 'invalid_candidate', '请选择本次研究中保存的候选人物。');
+        } else {
+          seedUrl = normalizeResearchUrl(request.seedUrl);
+          if (!seedUrl || (candidates.length > 0 && !candidates.some((candidate) => candidate.profileUrl === seedUrl))) {
+            throw new HttpError(400, 'invalid_seed_url', '请选择已有候选主页，或补充有效公开 HTTPS 主页。');
+          }
+        }
+      } else {
+        const checked = validateSeedUrl(request.seedUrl);
+        if (!checked.ok || !checked.url) throw new HttpError(400, 'invalid_seed_url', checked.error ?? '请提供主页链接。');
+        seedUrl = checked.url;
+        if (run.provider === 'github' && !extractGitHubHandle(seedUrl)) {
+          throw new HttpError(400, 'invalid_seed_url', 'GitHub 来源需要 https://github.com/<用户名> 形式的主页链接。');
+        }
+        if (run.provider === 'exa' && !isPublicHttpsUrl(seedUrl)) {
+          throw new HttpError(400, 'invalid_seed_url', 'Exa 的种子主页必须是可公开访问的 HTTPS 链接。');
+        }
+      }
+      const screen = screenQuestion(seedUrl);
+      if (screen.disallowed) throw new HttpError(422, 'scope_disallowed', screen.reason ?? '该请求不在可处理范围内。');
+
+      let input: PublicInputView | null = null;
+      let caseId: string | null = binding?.caseId ?? null;
+      let scopeVersion: ScopeVersion | null = null;
+
+      if (binding) {
+        const previous = this.store.inputs.getRevision(ownerId, binding.inputId, binding.inputRevision);
+        if (!previous) throw new HttpError(404, 'input_not_found', '未找到该输入记录。');
+        let classification = this.classify(seedUrl);
+        if (classification.ambiguities.length > 0 && !request.roleChoice) {
+          // Ambiguity stays visible: no write, no scheduling, no silent seed.
+          return {
+            kind: 'role_ambiguous',
+            ambiguities: classification.ambiguities,
+            input: this.store.inputs.publicView(previous)
+          };
+        }
+        if (request.roleChoice) {
+          classification = this.resolveRoleChoice(ownerId, classification, request.roleChoice);
+        }
+        const revision = this.store.inputs.recordRevision({
+          ownerId,
+          caseId: previous.caseId,
+          classification,
+          status: 'accepted',
+          inputId: binding.inputId
+        });
+        const caseRecord = this.store.cases.getCase(ownerId, previous.caseId);
+        if (!caseRecord) throw new HttpError(404, 'case_not_found', '未找到该研究案例。');
+        scopeVersion = this.applyInputScope(ownerId, caseRecord, revision, classification, Boolean(request.roleChoice));
+        this.store.inputs.rebindRun(runId, revision.inputId, revision.revision);
+        input = this.store.inputs.publicView(revision);
+        caseId = revision.caseId;
+      }
+
+      if (run.provider === 'research' && checkpoint) {
+        checkpoint.anchorUrl = seedUrl;
+        checkpoint.identity = null;
+        checkpoint.candidates = [];
+        checkpoint.phase = 'identity';
+        this.store.research.save(runId, checkpoint);
+      }
+      this.store.updateRun(runId, {
+        seed_url: seedUrl,
+        revision: run.revision + 1,
+        state: 'queued',
+        cancel_requested: 0,
+        error_code: null,
+        error_message: null,
+        stop_reason: null
+      });
+      this.store.addEvent(runId, 'input', {
+        resumed: true,
+        seedUrl,
+        ...(input ? { input } : {})
+      });
+      this.store.addEvent(runId, 'state', { state: 'queued', resumed: true });
+      return {
+        kind: 'resumed' as const,
+        run: this.store.getRun(runId)!,
+        input,
+        caseId,
+        scopeVersion
+      };
+    });
+  }
+
+  /** Public projection of a bound run's input (redacted; no email raw/hash). */
+  inputForRun(ownerId: string, runId: string): PublicInputView | null {
+    const binding = this.store.inputs.bindingForRun(runId);
+    if (!binding) return null;
+    const record = this.store.inputs.getRevision(ownerId, binding.inputId, binding.inputRevision);
+    return record ? this.store.inputs.publicView(record) : null;
+  }
+}
