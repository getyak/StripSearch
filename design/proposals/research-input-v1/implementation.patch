+/* ------------------------------------------------------------------ */
+/* Role ambiguity, confirmation, idempotency, isolation, atomicity     */
+/* ------------------------------------------------------------------ */
+
+test('roles stay ambiguous until confirmed; seeds, idempotency and rollback behave atomically', async (t) => {
+  const transport = new DenyTransport();
+  const server = await startTestServer({ providerFactory: createFakeFactory(), transport }, {}, {});
+  t.after(() => server.close());
+  await server.client.signUp('role-owner@example.test');
+  const foreign = new TestClient(server.baseUrl, server.origin);
+  await foreign.signUp('role-foreign@example.test');
+  const owner = await currentUser(server.client);
+
+  const postUrl = 'https://x.com/fixture_author/status/1789001234567890123';
+  const created = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: postUrl, provider: 'github' }
+  });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.queued, false);
+  assert.equal(created.body.run.state, 'needs_input');
+  assert.equal(created.body.roleAmbiguity.length, 1);
+  assert.deepEqual(created.body.roleAmbiguity[0]?.options, [
+    'select_resource_account',
+    'not_a_person_seed'
+  ]);
+  // Ambiguity stays visible: nothing was silently selected or queued.
+  assert.equal(countRows(server, 'research_case_accounts'), 0);
+  assert.equal(server.store.listQueuedRuns().length, 0);
+
+  const inputId = created.body.input!.inputId;
+  const inputRevision = created.body.input!.inputRevision;
+  const caseId = server.store.inputs.latestRevision(owner.id, inputId)!.caseId;
+  const before = server.store.cases.getCase(owner.id, caseId)!;
+
+  // A stale confirmation version is rejected.
+  const stale = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: {
+      input: postUrl,
+      provider: 'github',
+      roleChoice: { choice: 'select_resource_account', inputId, inputRevision: inputRevision + 5 }
+    }
+  });
+  assert.equal(stale.status, 409);
+  assert.equal(stale.body.error.code, 'stale_input');
+
+  // A role choice against an input the server never flagged ambiguous conflicts.
+  const plain = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: 'Research Ada Fixture', provider: 'github' }
+  });
+  const conflict = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: {
+      input: postUrl,
+      provider: 'github',
+      roleChoice: {
+        choice: 'select_resource_account',
+        inputId: plain.body.input!.inputId,
+        inputRevision: 1
+      }
+    }
+  });
+  assert.equal(conflict.status, 409);
+  assert.equal(conflict.body.error.code, 'role_choice_conflict');
+
+  // Explicit confirmation selects the account scope without identity upgrade.
+  const confirmed = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: {
+      input: postUrl,
+      provider: 'github',
+      roleChoice: { choice: 'select_resource_account', inputId, inputRevision },
+      caseId,
+      expectedScopeVersion: before.scopeVersion
+    }
+  });
+  assert.equal(confirmed.status, 201);
+  assert.equal(confirmed.body.queued, true);
+  const accounts = server.store.cases.listAccounts(owner.id, caseId);
+  assert.equal(accounts.length, 1);
+  assert.equal(accounts[0]?.handle, 'fixture_author');
+  assert.equal(accounts[0]?.userSelection.state, 'selected');
+  assert.equal(accounts[0]?.identitySupport.state, 'proposed');
+  const after = server.store.cases.getCase(owner.id, caseId)!;
+  assert.ok(after.scopeVersion > before.scopeVersion, 'confirmation advanced the scope version');
+  const revisions = server.store.inputs.listRevisions(owner.id, inputId);
+  assert.equal(revisions[0]?.status, 'needs_role_confirmation');
+  assert.ok(revisions.length >= 2);
+  // The earlier ambiguous run is still there as visible history.
+  assert.equal(server.store.getRun(created.body.run.runId)?.state, 'needs_input');
+
+  // A resource-only confirmation runs without any account scope.
+  const resourceOnly = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: {
+      input: 'https://fixture-magazine.example.test/interviews/fixture-person',
+      provider: 'github',
+      roleChoice: { choice: 'not_a_person_seed' }
+    }
+  });
+  assert.equal(resourceOnly.status, 201);
+  assert.equal(resourceOnly.body.queued, true);
+  assert.equal(
+    server.store.cases.listAccounts(
+      owner.id,
+      server.store.inputs.latestRevision(owner.id, resourceOnly.body.input!.inputId)!.caseId
+    ).length,
+    0
+  );
+
+  /* ---------------- idempotency and isolation ---------------- */
+
+  const body = { input: 'https://github.com/fixture-owner', provider: 'github' };
+  const first = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'input-key-1' },
+    json: body
+  });
+  assert.equal(first.status, 201);
+  const inputsAfterFirst = countRows(server, 'research_inputs');
+  const scopeAfterFirst = countRows(server, 'research_case_scope_versions');
+
+  const replay = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'input-key-1' },
+    json: body
+  });
+  assert.equal(replay.status, 200);
+  assert.equal(replay.body.idempotent, true);
+  assert.equal(replay.body.run.runId, first.body.run.runId);
+  assert.equal(countRows(server, 'research_inputs'), inputsAfterFirst, 'replay added an input');
+  assert.equal(countRows(server, 'research_case_scope_versions'), scopeAfterFirst, 'replay advanced scope');
+
+  // A changed role choice under the same key is an explicit conflict.
+  const changedRole = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'input-key-1' },
+    json: { ...body, roleChoice: { choice: 'not_a_person_seed' } }
+  });
+  assert.equal(changedRole.status, 409);
+  assert.equal(changedRole.body.error.code, 'idempotency_conflict');
+  // Another owner cannot reuse the key.
+  const stolenKey = await foreign.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'input-key-1' },
+    json: body
+  });
+  assert.equal(stolenKey.status, 409);
+  assert.equal(stolenKey.body.error.code, 'idempotency_conflict');
+
+  // Stale scope and foreign references reject without partial writes.
+  const idemCaseId = server.store.inputs.latestRevision(owner.id, first.body.input!.inputId)!.caseId;
+  const staleScope = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: { ...body, caseId: idemCaseId, expectedScopeVersion: 1 }
+  });
+  assert.equal(staleScope.status, 409);
+  assert.equal(staleScope.body.error.code, 'stale_scope');
+  const foreignCreated = await foreign.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  const foreignCaseId = server.store.inputs
+    .latestRevision((await currentUser(foreign)).id, foreignCreated.body.input!.inputId)!
+    .caseId;
+  const stolenCase = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: { ...body, caseId: foreignCaseId }
+  });
+  assert.equal(stolenCase.status, 404);
+  assert.equal(stolenCase.body.error.code, 'case_not_found');
+  const stolenInput = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    json: {
+      input: postUrl,
+      provider: 'github',
+      roleChoice: {
+        choice: 'select_resource_account',
+        inputId: foreignCreated.body.input!.inputId,
+        inputRevision: 1
+      }
+    }
+  });
+  assert.equal(stolenInput.status, 404);
+  assert.equal(stolenInput.body.error.code, 'input_not_found');
+
+  // Even after the scope moved on, the original key replays the original run.
+  const inputsBeforeFinalReplay = countRows(server, 'research_inputs');
+  server.store.cases.applyCaseScopeMutation({
+    ownerId: owner.id,
+    caseId: idemCaseId,
+    expectedScopeVersion: server.store.cases.getCase(owner.id, idemCaseId)!.scopeVersion,
+    reason: 'test_scope_move',
+    advance: true
+  });
+  const later = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'input-key-1' },
+    json: body
+  });
+  assert.equal(later.status, 200);
+  assert.equal(later.body.idempotent, true);
+  assert.equal(later.body.run.runId, first.body.run.runId);
+  assert.equal(countRows(server, 'research_inputs'), inputsBeforeFinalReplay);
+
+  /* ---------------- pre-commit rollback vs post-commit loss ---------------- */
+
+  const beforeCounts = {
+    cases: countRows(server, 'research_cases'),
+    inputs: countRows(server, 'research_inputs'),
+    auth: countRows(server, 'research_input_authorizations'),
+    accounts: countRows(server, 'research_case_accounts'),
+    scope: countRows(server, 'research_case_scope_versions'),
+    runs: countRows(server, 'runs'),
+    bindings: countRows(server, 'research_input_bindings'),
+    keys: countRows(server, 'idempotency_keys'),
+    events: countRows(server, 'run_events')
+  };
+  // A legal first reference plus a foreign second reference: full rollback of
+  // input, authorization, scope journal, account, run, binding, events and the
+  // idempotency key; the queue sees nothing.
+  const failed = await server.client.json<ErrorBody>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'rollback-key' },
+    json: {
+      input: EMAIL_RAW,
+      emailConsent: { basis: 'self' },
+      parentRunId: 'run_foreign_does_not_exist'
+    }
+  });
+  assert.equal(failed.status, 404);
+  assert.equal(failed.body.error.code, 'parent_not_found');
+  for (const [table, expected] of Object.entries({
+    research_cases: beforeCounts.cases,
+    research_inputs: beforeCounts.inputs,
+    research_input_authorizations: beforeCounts.auth,
+    research_case_accounts: beforeCounts.accounts,
+    research_case_scope_versions: beforeCounts.scope,
+    runs: beforeCounts.runs,
+    research_input_bindings: beforeCounts.bindings,
+    idempotency_keys: beforeCounts.keys,
+    run_events: beforeCounts.events
+  })) {
+    assert.equal(countRows(server, table), expected, `${table} changed after rollback`);
+  }
+  assert.equal(server.store.listQueuedRuns().length, 0);
+  assert.equal(transport.calls.length, 0);
+  // The rolled-back idempotency key is free again for a corrected submission.
+  const corrected = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'rollback-key' },
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(corrected.status, 201);
+
+  // Post-commit queue trigger failure: the durable commit happened first.
+  const realEnqueue = server.boot.runner.enqueue.bind(server.boot.runner);
+  server.boot.runner.enqueue = () => {
+    throw new Error('queue trigger down');
+  };
+  const committed = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'commit-key-1' },
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(committed.status, 201);
+  assert.ok(server.store.getRun(committed.body.run.runId), 'run durable despite queue failure');
+  const scopeCount = countRows(server, 'research_case_scope_versions');
+  server.boot.runner.enqueue = realEnqueue;
+  const retriedSame = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'commit-key-1' },
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(retriedSame.status, 200);
+  assert.equal(retriedSame.body.idempotent, true);
+  assert.equal(retriedSame.body.run.runId, committed.body.run.runId);
+  assert.equal(countRows(server, 'research_case_scope_versions'), scopeCount, 'retry re-advanced scope');
+
+  // Post-commit response loss: the commit happened even though the response
+  // failed; retrying the same key returns the SAME record.
+  const realView = server.store.buildCanonicalView.bind(server.store);
+  let failOnce = true;
+  (server.store as unknown as { buildCanonicalView: (run: never) => unknown }).buildCanonicalView = (
+    run: never
+  ) => {
+    if (failOnce) {
+      failOnce = false;
+      throw new Error('response lost');
+    }
+    return realView(run);
+  };
+  const lost = await server.client.json('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'commit-key-2' },
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(lost.status, 500);
+  const recovered = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    headers: { 'idempotency-key': 'commit-key-2' },
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(recovered.status, 200);
+  assert.equal(recovered.body.idempotent, true);
+  assert.equal(countRows(server, 'research_case_scope_versions'), scopeCount + 2);
+});
+
+/* ------------------------------------------------------------------ */
+/* Persistence across reopen                                          */
+/* ------------------------------------------------------------------ */
+
+test('input revisions and scope history survive a real close and reopen', async (t) => {
+  const dataDir = mkdtempSync(path.join(tmpdir(), 'stripsearch-input-reopen-'));
+  t.after(() => rmSync(dataDir, { recursive: true, force: true }));
+  const first = await startTestServer(
+    { providerFactory: createFakeFactory() },
+    {},
+    { dataDir, preserveData: true }
+  );
+  await first.client.signUp('reopen@example.test');
+  const created = await first.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(created.status, 201);
+  const inputId = created.body.input!.inputId;
+  const runId = created.body.run.runId;
+  await first.close();
+
+  const second = await startTestServer(
+    { providerFactory: createFakeFactory() },
+    {},
+    { dataDir, preserveData: true }
+  );
+  t.after(() => second.close());
+  await second.client.signIn('reopen@example.test');
+  const owner = await currentUser(second.client);
+  const revisions = second.store.inputs.listRevisions(owner.id, inputId);
+  assert.equal(revisions.length, 1);
+  assert.equal(revisions[0]?.classification.accountSeed?.handle, 'fixture-owner');
+  const binding = second.store.inputs.bindingForRun(runId);
+  assert.equal(binding?.inputId, inputId);
+  const caseRecord = second.store.cases.getCase(owner.id, binding!.caseId);
+  assert.ok(caseRecord);
+  const history = second.store.cases.scopeHistory(owner.id, binding!.caseId);
+  assert.equal(history.length, 2);
+  assert.equal(history.at(-1)?.reason, 'input_account_selected');
+  const accounts = second.store.cases.listAccounts(owner.id, binding!.caseId);
+  assert.equal(accounts[0]?.userSelection.state, 'selected');
+});
