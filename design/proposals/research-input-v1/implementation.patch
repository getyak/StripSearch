+      ownerId: request.ownerId,
+      caseId: caseRecord.caseId,
+      inputId: revision.inputId,
+      inputRevision: revision.revision,
+      normalizedValue: revision.normalizedValue,
+      actorId: request.ownerId,
+      basis: consent.basis
