+      // 7. Second references validated last: a foreign parent/retry rolls the
+      //    entire submission back (input, authorization, scope journal,
+      //    account, run, binding, events and idempotency key) and the queue
+      //    sees nothing.
+      if (request.parentRunId && !this.store.getRunForOwner(request.parentRunId, ownerId)) {
