+
+    // Provider availability only gates work that would actually be scheduled;
+    // it must never block safe local parsing or authorization persistence.
+    if (queueable) {
+      if (request.provider === 'research' && !request.config.researchConfigured) {
+        throw new HttpError(409, 'provider_unavailable', '人物研究需要服务端配置 DeepSeek 与 Exa。');
+      }
+      if (request.provider === 'exa' && !request.config.exaConfigured) {
+        throw new HttpError(
+          409,
+          'provider_unavailable',
+          'Exa 未配置。请让服务端配置 Exa，或改用 GitHub 公开账号。'
+        );
+      }
+      const { seed, candidate } = this.runSeedUrl(base, request.legacySeedUrl, request.provider);
+      if (request.provider === 'research' && candidate && !seed) {
+        throw new HttpError(400, 'invalid_seed_url', '请使用可公开访问的 HTTPS 人物主页链接。');
+      }
+      if (request.provider === 'research' && /https?:\/\//i.test(request.text) && !seed) {
+        throw new HttpError(400, 'invalid_seed_url', '请使用可公开访问的 HTTPS 人物主页链接。');
+      }
+      if (request.provider === 'exa' && candidate && !isPublicHttpsUrl(candidate)) {
+        throw new HttpError(400, 'invalid_seed_url', 'Exa 的种子主页必须是可公开访问的 HTTPS 链接。');
+      }
+    }
