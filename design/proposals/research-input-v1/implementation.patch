diff --git a/apps/web/src/shared/research-input.ts b/apps/web/src/shared/research-input.ts
new file mode 100644
index 0000000..13083f3
--- /dev/null
+++ b/apps/web/src/shared/research-input.ts
@@ -0,0 +1,782 @@
+/**
+ * GET-62 unified research input contract ("stripsearch/research-input/v1").
+ *
+ * One input envelope for links, usernames and authorized emails. Parsing and
+ * classification are pure and local: typing, pasting, blur and preview never
+ * send the value anywhere. Only an explicit submit may POST the input to this
+ * app, and a sensitive (email) input additionally needs an explicit,
+ * server-resolved authorization record before it is accepted at all.
+ *
+ * Boundaries baked into this contract:
+ *
+ * - The original full URL is preserved verbatim in `originalUrl`; resource ids
+ *   and publisher clues live in separate anchors. A post/article URL never
+ *   silently becomes a person profile: author, publisher and intended subject
+ *   are separate roles and are never merged from a URL.
+ * - A GitHub `/handle` proves only that an account exists: person vs
+ *   organization stays `unknown` and never becomes an identity fact.
+ * - A bare username is a clue only: no platform, profile or person is inferred
+ *   from it. An explicit platform-qualified username is an account clue per
+ *   platform rules and never merges across platforms.
+ * - Email normalization preserves the local part verbatim (case, dots, `+tag`)
+ *   and only normalizes the domain per generic rules (lowercase, one trailing
+ *   dot removed). No username is guessed from an email and no vendor-specific
+ *   (Gmail/Gravatar) transform is applied at intake.
+ * - Email values are sensitive: `normalizedValue` is internal-only and public
+ *   DTOs use `displayValue` (redacted). Neither the raw text nor any hash of
+ *   it may appear in UI previews, summaries, events, reports, exports, errors
+ *   or logs.
+ *
+ * IDs are plain strings (the GET-58 world has no imported CaseId/AccountRef
+ * types); scope changes go through the single GET-58 case-level scope path.
+ */
+
+import { LIMITS } from './limits.js';
+import { isPrivateHost } from './validation.js';
+
+export const RESEARCH_INPUT_SCHEMA_VERSION = 'stripsearch/research-input/v1';
+
+/* ------------------------------------------------------------------ */
+/* Kinds                                                              */
+/* ------------------------------------------------------------------ */
+
+export type ResearchInputKind =
+  /** A subject email address (or a question containing one). Sensitive. */
+  | 'email'
+  /** The whole input is one URL. */
+  | 'url'
+  /** `platform:handle` — an account clue scoped to one platform. */
+  | 'platform_username'
+  /** A bare username-shaped token: a clue only, no platform inference. */
+  | 'username_clue'
+  /** Anything else: a name or research question. */
+  | 'text';
+
+/** The five URL role distinctions the classifier must preserve. */
+export type UrlRole = 'personal_profile' | 'post' | 'article' | 'organization' | 'unknown';
+
+export type AccountRole = 'unknown' | 'person' | 'organization';
+
+/** What the input says the user wants researched. Never an identity claim. */
+export type IntendedScope = 'person_research' | 'account_only' | 'resource_research' | 'unresolved';
+
+/* ------------------------------------------------------------------ */
+/* Anchors                                                            */
+/* ------------------------------------------------------------------ */
+
+export type AnchorRole = 'resource' | 'publisher' | 'intended_subject';
+
+export interface InputAnchor {
+  /** Resource vs publisher vs intended subject are kept distinct forever. */
+  anchorRole: AnchorRole;
+  urlRole: UrlRole | 'account' | 'site';
+  platform: string | null;
+  /** Stable resource id when recognized (repo path, status id, comment id…). */
+  resourceId: string | null;
+  /** The URL exactly as typed/parsed; never rewritten. */
+  originalUrl: string | null;
+  /** Public normalized form (tracking params stripped); null when not a URL. */
+  normalizedUrl: string | null;
+  handle: string | null;
+  note: string;
+}
+
+export interface AccountSeed {
+  platform: string | null;
+  handle: string | null;
+  profileUrl: string | null;
+  /** Person vs organization is only asserted when the URL proves it. */
+  accountRole: AccountRole;
+  basis: 'profile_url' | 'platform_username' | 'role_confirmation';
+  note: string;
+}
+
+/** Confirmation actions offered when a URL cannot name its research subject. */
+export type RoleChoiceValue = 'select_resource_account' | 'not_a_person_seed';
+
+export interface RoleAmbiguity {
+  code: 'publisher_subject_unresolved' | 'resource_role_unconfirmed';
+  message: string;
+  options: RoleChoiceValue[];
+  /** The account the `select_resource_account` choice would select, if any. */
+  candidate: AccountSeed | null;
+}
+
+export type InputStatus = 'accepted' | 'needs_role_confirmation' | 'unsupported_email';
+
+export interface ResearchInputClassification {
+  kind: ResearchInputKind;
+  /** The full text exactly as the user typed it (internal only when sensitive). */
+  originalValue: string;
+  /** Normalized value. Email: local part verbatim + domain normalized. */
+  normalizedValue: string;
+  /** Public-safe rendering; redacted for sensitive kinds. */
+  displayValue: string;
+  /** Sensitive values must never leave the app except via this app's POST. */
+  sensitive: boolean;
+  anchors: InputAnchor[];
+  /** A directly usable account seed (clear profile URL or platform username). */
+  accountSeed: AccountSeed | null;
+  ambiguities: RoleAmbiguity[];
+  intendedScope: IntendedScope;
+  notes: string[];
+}
+
+export type ClassificationResult =
+  | { ok: true; classification: ResearchInputClassification }
+  | { ok: false; code: 'invalid_input_url' | 'unsafe_input_url'; error: string };
+
+/* ------------------------------------------------------------------ */
+/* Email handling (sensitive)                                         */
+/* ------------------------------------------------------------------ */
+
+const EMAIL_TOKEN_RE = /[^\s@<>"'()[\],;:]+@[^\s@<>"'()[\],;:]+\.[^\s@<>"'()[\],;:]+/g;
+
+function isEmailShaped(value: string): boolean {
+  if (value.length === 0 || value.length > LIMITS.emailMax) return false;
+  const at = value.lastIndexOf('@');
+  if (at <= 0 || at === value.length - 1) return false;
+  const local = value.slice(0, at);
+  const domain = value.slice(at + 1);
+  if (local.length > 64) return false;
+  if (/[\s@<>\"'()[\],;:]/.test(local)) return false;
+  return /^[^\s@.]+(?:\.[^\s@.]+)+$/.test(domain);
+}
+
+/**
+ * Generic email normalization: the local part is preserved verbatim (case,
+ * dots and `+tag` all survive); only the domain is normalized (lowercased, one
+ * trailing dot removed). No vendor-specific transforms are applied.
+ */
+export function normalizeEmailValue(raw: unknown): string | null {
+  if (typeof raw !== 'string') return null;
+  const text = raw.trim();
+  if (text.length === 0 || text.length > LIMITS.emailMax) return null;
+  const at = text.lastIndexOf('@');
+  if (at <= 0 || at === text.length - 1) return null;
+  const local = text.slice(0, at);
+  let domain = text.slice(at + 1);
+  if (domain.endsWith('.')) domain = domain.slice(0, -1);
+  domain = domain.toLowerCase();
+  if (local.length > 64) return null;
+  if (!isEmailShaped(`${local}@${domain}`)) return null;
+  return `${local}@${domain}`;
+}
+
+/** Public rendering of an email: no raw local part, no hash, no full domain. */
+export function redactEmailValue(raw: string): string {
+  const at = raw.lastIndexOf('@');
+  if (at <= 0) return '（邮箱已隐藏）';
+  const local = raw.slice(0, at);
+  const domain = raw.slice(at + 1);
+  const labels = domain.split('.').filter(Boolean);
+  const tld = labels.length > 1 ? labels[labels.length - 1] : null;
+  const domainHead = labels.length > 0 ? labels[0]![0] : '';
+  return `${local[0] ?? ''}***@${domainHead}***${tld ? `.${tld}` : ''}`;
+}
+
+/** First email-shaped token inside free text, or null. */
+export function findEmailToken(text: string): string | null {
+  const matches = text.match(EMAIL_TOKEN_RE);
+  if (!matches) return null;
+  for (const match of matches) {
+    const normalized = normalizeEmailValue(match);
+    if (normalized) return normalized;
+  }
+  return null;
+}
+
+export function containsEmailToken(text: string): boolean {
+  return findEmailToken(text) !== null;
+}
+
+/**
+ * Read-time redaction for legacy and derived text. Deliberately cosmetic: it
+ * never rewrites stored history and never produces a hash of the value.
+ */
+export function redactEmailsInText(text: string): string {
+  return text.replace(EMAIL_TOKEN_RE, (token) => {
+    const normalized = normalizeEmailTokenLoose(token);
+    return normalized ? redactEmailValue(normalized) : '（邮箱已隐藏）';
+  });
+}
+
+function normalizeEmailTokenLoose(token: string): string | null {
+  const at = token.lastIndexOf('@');
+  if (at <= 0) return null;
+  const local = token.slice(0, at);
+  let domain = token.slice(at + 1);
+  if (domain.endsWith('.')) domain = domain.slice(0, -1);
+  domain = domain.toLowerCase();
+  return `${local}@${domain}`;
+}
+
+/** Deep read-time sanitization for public DTOs, events and exports. */
+export function sanitizePublicValue(value: unknown): unknown {
+  if (typeof value === 'string') return redactEmailsInText(value);
+  if (Array.isArray(value)) return value.map(sanitizePublicValue);
+  if (value !== null && typeof value === 'object') {
+    const out: Record<string, unknown> = {};
+    for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+      out[key] = sanitizePublicValue(item);
+    }
+    return out;
+  }
+  return value;
+}
+
+/* ------------------------------------------------------------------ */
+/* URL classification (pure, no network)                              */
+/* ------------------------------------------------------------------ */
+
+/** Hosts whose URL shape names an account. www. is equivalent. */
+const PLATFORM_HOSTS: Record<string, string> = {
+  'github.com': 'github',
+  'x.com': 'x',
+  'twitter.com': 'x',
+  'reddit.com': 'reddit'
+};
+
+/** Profile URL shape per platform for platform-qualified usernames. */
+const PLATFORM_PROFILE_URL: Record<string, (handle: string) => string> = {
+  github: (handle) => `https://github.com/${handle}`,
+  x: (handle) => `https://x.com/${handle}`,
+  reddit: (handle) => `https://www.reddit.com/user/${handle}`
+};
+
+const GITHUB_HANDLE_RE = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/;
+const X_HANDLE_RE = /^[A-Za-z0-9_]{1,15}$/;
+const REDDIT_HANDLE_RE = /^[A-Za-z0-9_-]{3,20}$/;
+
+const RESERVED_GITHUB = new Set([
+  'about', 'account', 'apps', 'blog', 'contact', 'explore', 'features', 'issues',
+  'login', 'logout', 'marketplace', 'new', 'notifications', 'orgs', 'pricing',
+  'pulls', 'search', 'security', 'settings', 'signup', 'site', 'sponsors',
+  'topics', 'trending'
+]);
+
+const UNSAFE_SCHEME_RE = /^(?:javascript|data|file|vbscript|blob|about|ftp|mailto|tel):/i;
+
+function isUrlLikeToken(token: string): boolean {
+  return (
+    UNSAFE_SCHEME_RE.test(token) ||
+    /^[A-Za-z][A-Za-z0-9+.-]*:\/\//.test(token) ||
+    /^www\./i.test(token) ||
+    /^https?:/i.test(token)
+  );
+}
+
+/** Split free text into words and URL-like tokens (URLs keep their delimiters). */
+export function tokenizeInput(text: string): { token: string; urlLike: boolean }[] {
+  const out: { token: string; urlLike: boolean }[] = [];
+  const re = /[^\s]+/g;
+  for (const match of text.match(re) ?? []) {
+    out.push({ token: match, urlLike: isUrlLikeToken(match) });
+  }
+  return out;
+}
+
+interface ParsedUrl {
+  url: URL;
+  original: string;
+  normalized: string;
+}
+
+function parsePublicUrl(token: string): { ok: true; parsed: ParsedUrl } | { ok: false; code: 'invalid_input_url' | 'unsafe_input_url'; error: string } {
+  const trimmed = token.trim();
+  if (trimmed.length === 0 || trimmed.length > LIMITS.seedUrlMax) {
+    return { ok: false, code: 'invalid_input_url', error: '链接格式不正确。' };
+  }
+  if (/[\u0000-\u001f\u007f]/.test(trimmed)) {
+    return { ok: false, code: 'invalid_input_url', error: '链接不能包含换行或控制字符。' };
+  }
+  let url: URL;
+  try {
+    url = new URL(trimmed);
+  } catch {
+    return { ok: false, code: 'invalid_input_url', error: '请输入完整的 http(s) 链接。' };
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    const unsafe = UNSAFE_SCHEME_RE.test(trimmed);
+    return {
+      ok: false,
+      code: unsafe ? 'unsafe_input_url' : 'invalid_input_url',
+      error: '只支持 http 或 https 链接。'
+    };
+  }
+  if (url.username || url.password) {
+    return { ok: false, code: 'unsafe_input_url', error: '链接不能包含用户名或密码。' };
+  }
+  if (!url.hostname) {
+    return { ok: false, code: 'invalid_input_url', error: '链接缺少主机名。' };
+  }
+  if (isPrivateHost(url.hostname)) {
+    return { ok: false, code: 'unsafe_input_url', error: '不接受本地或内网地址。' };
+  }
+  return { ok: true, parsed: { url, original: trimmed, normalized: normalizeUrlPublic(url) } };
+}
+
+/** Tracking-param/fragment stripping only; the original stays on the anchor. */
+function normalizeUrlPublic(input: URL): string {
+  const url = new URL(input.href);
+  url.hash = '';
+  for (const key of [...url.searchParams.keys()]) {
+    if (/^(utm_|fbclid$|gclid$)/i.test(key)) url.searchParams.delete(key);
+  }
+  if (url.hostname === 'www.github.com') url.hostname = 'github.com';
+  if (['www.x.com', 'twitter.com', 'www.twitter.com'].includes(url.hostname)) url.hostname = 'x.com';
+  url.pathname = url.pathname.replace(/\/+$/, '') || '/';
+  if (['github.com', 'x.com'].includes(url.hostname) && url.pathname.split('/').filter(Boolean).length === 1) {
+    url.pathname = url.pathname.toLowerCase();
+  }
+  return url.href;
+}
+
+function platformOf(hostname: string): string | null {
+  const host = hostname.toLowerCase();
+  return PLATFORM_HOSTS[host] ?? PLATFORM_HOSTS[host.replace(/^www\./, '')] ?? null;
+}
+
+function urlAnchor(anchorRole: AnchorRole, urlRole: UrlRole | 'account' | 'site', parsed: ParsedUrl | null, extra: Partial<InputAnchor> = {}): InputAnchor {
+  return {
+    anchorRole,
+    urlRole,
+    platform: extra.platform ?? null,
+    resourceId: extra.resourceId ?? null,
+    originalUrl: parsed?.original ?? null,
+    normalizedUrl: parsed?.normalized ?? null,
+    handle: extra.handle ?? null,
+    note: extra.note ?? ''
+  };
+}
+
+interface UrlClassification {
+  urlRole: UrlRole;
+  anchors: InputAnchor[];
+  accountSeed: AccountSeed | null;
+  ambiguities: RoleAmbiguity[];
+  notes: string[];
+  intendedScope: IntendedScope;
+}
+
+const ORG_NOTE = '组织页指向组织账号，不产生自然人事实。';
+const GITHUB_ROLE_NOTE = 'GitHub 主页只指向账号；是个人还是组织仅凭 URL 无法判定。';
+
+function classifyParsedUrl(parsed: ParsedUrl): UrlClassification {
+  const platform = platformOf(parsed.url.hostname);
+  const segments = parsed.url.pathname.split('/').filter(Boolean);
+
+  if (platform === 'github') {
+    if (segments[0] === 'orgs' && segments.length >= 2 && GITHUB_HANDLE_RE.test(segments[1]!)) {
+      const org = segments[1]!;
+      return {
+        urlRole: 'organization',
+        anchors: [urlAnchor('resource', 'organization', parsed, { platform, handle: org, resourceId: `orgs/${org}`, note: ORG_NOTE })],
+        accountSeed: {
+          platform,
+          handle: org,
+          profileUrl: parsed.normalized,
+          accountRole: 'organization',
+          basis: 'profile_url',
+          note: ORG_NOTE
+        },
+        ambiguities: [],
+        notes: [ORG_NOTE],
+        intendedScope: 'account_only'
+      };
+    }
+    if (segments.length === 1 && GITHUB_HANDLE_RE.test(segments[0]!) && !RESERVED_GITHUB.has(segments[0]!.toLowerCase())) {
+      const handle = segments[0]!;
+      return {
+        urlRole: 'personal_profile',
+        anchors: [urlAnchor('intended_subject', 'account', parsed, { platform, handle, resourceId: handle, note: GITHUB_ROLE_NOTE })],
+        accountSeed: {
+          platform,
+          handle,
+          profileUrl: parsed.normalized,
+          accountRole: 'unknown',
+          basis: 'profile_url',
+          note: GITHUB_ROLE_NOTE
+        },
+        ambiguities: [],
+        notes: [GITHUB_ROLE_NOTE, '账号可直接选为研究范围；不升级身份支持，也不宣称跨平台同一人。'],
+        intendedScope: 'account_only'
+      };
+    }
+    if (segments.length >= 2 && GITHUB_HANDLE_RE.test(segments[0]!)) {
+      const owner = segments[0]!;
+      const resourceId = segments.join('/');
+      return {
+        urlRole: 'post',
+        anchors: [
+          urlAnchor('resource', 'post', parsed, { platform, resourceId, note: '仓库/议题/PR 是资源，不是人物主页。' }),
+          urlAnchor('publisher', 'account', parsed, { platform, handle: owner, resourceId: owner, note: '发布账号线索；不等于研究对象。' })
+        ],
+        accountSeed: null,
+        ambiguities: [{
+          code: 'publisher_subject_unresolved',
+          message: '这是资源链接。发布者、受访者与研究对象不能只凭 URL 合并；请确认要研究的账号。',
+          options: ['select_resource_account', 'not_a_person_seed'],
+          candidate: {
+            platform,
+            handle: owner,
+            profileUrl: `https://github.com/${owner}`,
+            accountRole: 'unknown',
+            basis: 'role_confirmation',
+            note: '用户确认选择的发布账号；身份保持 proposed。'
+          }
+        }],
+        notes: ['保留资源 ID 与原 URL；不把发布者默认为研究对象。'],
+        intendedScope: 'resource_research'
+      };
+    }
+    return unknownUrl(parsed, platform, segments);
+  }
+
+  if (platform === 'x') {
+    if (segments.length === 1 && X_HANDLE_RE.test(segments[0]!)) {
+      const handle = segments[0]!;
+      return {
+        urlRole: 'personal_profile',
+        anchors: [urlAnchor('intended_subject', 'account', parsed, { platform, handle, resourceId: handle, note: '账号主页；是个人还是组织账号仅凭 URL 无法判定。' })],
+        accountSeed: {
+          platform,
+          handle,
+          profileUrl: parsed.normalized,
+          accountRole: 'unknown',
+          basis: 'profile_url',
+          note: 'X 主页只指向账号；不升级身份支持。'
+        },
+        ambiguities: [],
+        notes: ['账号可直接选为研究范围；不升级身份支持，也不宣称跨平台同一人。'],
+        intendedScope: 'account_only'
+      };
+    }
+    if (segments.length >= 3 && X_HANDLE_RE.test(segments[0]!) && segments[1] === 'status' && /^\d+$/.test(segments[2]!)) {
+      const handle = segments[0]!;
+      return {
+        urlRole: 'post',
+        anchors: [
+          urlAnchor('resource', 'post', parsed, { platform, resourceId: segments[2]!, note: '帖子资源 ID 与原 URL 保留。' }),
+          urlAnchor('publisher', 'account', parsed, { platform, handle, resourceId: handle, note: '发布账号线索；帖子可能引用或采访他人。' })
+        ],
+        accountSeed: null,
+        ambiguities: [{
+          code: 'publisher_subject_unresolved',
+          message: '这是帖子链接。发布者、被提及者与研究对象不能只凭 URL 合并；请确认要研究的账号。',
+          options: ['select_resource_account', 'not_a_person_seed'],
+          candidate: {
+            platform,
+            handle,
+            profileUrl: `https://x.com/${handle}`,
+            accountRole: 'unknown',
+            basis: 'role_confirmation',
+            note: '用户确认选择的发布账号；身份保持 proposed。'
+          }
+        }],
+        notes: ['保留帖子 ID 与原 URL；不把提及对象或受访者默认为发布者。'],
+        intendedScope: 'resource_research'
+      };
+    }
+    return unknownUrl(parsed, platform, segments);
+  }
+
+  if (platform === 'reddit') {
+    if ((segments[0] === 'user' || segments[0] === 'u') && segments.length >= 2 && REDDIT_HANDLE_RE.test(segments[1]!)) {
+      const handle = segments[1]!;
+      return {
+        urlRole: 'personal_profile',
+        anchors: [urlAnchor('intended_subject', 'account', parsed, { platform, handle, resourceId: handle, note: 'Reddit 账号主页；只研究公开账号，不推断现实身份。' })],
+        accountSeed: {
+          platform,
+          handle,
+          profileUrl: parsed.normalized,
+          accountRole: 'unknown',
+          basis: 'profile_url',
+          note: 'Reddit 主页只指向账号；不推断现实身份。'
+        },
+        ambiguities: [],
+        notes: ['账号可直接选为研究范围；不升级身份支持。'],
+        intendedScope: 'account_only'
+      };
+    }
+    if (segments[0] === 'r' && segments.length >= 2) {
+      const community = `r/${segments[1]!}`;
+      const commentId = segments[1] === 'comments' && segments.length >= 3 ? segments[2]! : segments.includes('comments') ? (segments[segments.indexOf('comments') + 1] ?? null) : null;
+      return {
+        urlRole: 'post',
+        anchors: [
+          urlAnchor('resource', 'post', parsed, { platform, resourceId: commentId, note: '帖子/评论资源；保留原 URL。' }),
+          urlAnchor('publisher', 'site', parsed, { platform, handle: community, note: '社区线索；发帖者与受访者不能只凭 URL 判定。' })
+        ],
+        accountSeed: null,
+        ambiguities: [{
+          code: 'publisher_subject_unresolved',
+          message: '这是 Reddit 帖子链接。社区、发帖者与研究对象不能只凭 URL 合并；请确认要研究的账号。',
+          options: ['not_a_person_seed'],
+          candidate: null
+        }],
+        notes: ['保留社区与资源 ID；不把发帖者默认为研究对象。'],
+        intendedScope: 'resource_research'
+      };
+    }
+    return unknownUrl(parsed, platform, segments);
+  }
+
+  return unknownUrl(parsed, platform, segments);
+}
+
+function unknownUrl(parsed: ParsedUrl, platform: string | null, segments: string[]): UrlClassification {
+  const hostNote = 'example.org/example.com/example.net 是占位域名，不作为抓取目标。';
+  const isFixtureHost = /^(?:www\.)?example\.(?:org|com|net)$/.test(parsed.url.hostname.toLowerCase());
+  const urlRole: UrlRole = segments.length === 0 ? 'unknown' : 'article';
+  const message =
+    urlRole === 'unknown'
+      ? '这是站点地址。仅凭 URL 无法判定它是个人主页、组织页还是其他内容。'
+      : '这是文章/访谈类链接。作者、发布者与受访者不能只凭 URL 判定或合并。';
+  return {
+    urlRole,
+    anchors: [
+      urlAnchor('resource', urlRole, parsed, {
+        platform,
+        resourceId: segments.length > 0 ? segments.join('/') : null,
+        note: message
+      }),
+      urlAnchor('publisher', 'site', parsed, { platform, note: '站点线索；不是已确认的发布账号。' })
+    ],
+    accountSeed: null,
+    ambiguities: [{
+      code: 'resource_role_unconfirmed',
+      message: `${message}请确认要把该地址当作研究账号/主页，或只作为资料链接。`,
+      options: ['select_resource_account', 'not_a_person_seed'],
+      candidate: {
+        platform: platform ?? 'web',
+        handle: null,
+        profileUrl: parsed.normalized,
+        accountRole: 'unknown',
+        basis: 'role_confirmation',
+        note: '用户确认把该地址作为研究主页；身份保持 proposed。'
+      }
+    }],
+    notes: isFixtureHost ? [hostNote, message] : [message],
+    intendedScope: 'unresolved'
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Full input classification                                          */
+/* ------------------------------------------------------------------ */
+
+const PLATFORM_USERNAME_RE = /^([A-Za-z][A-Za-z0-9_-]{0,23}):@?([A-Za-z0-9](?:[A-Za-z0-9_-]{0,38}[A-Za-z0-9])?)$/;
+const BARE_USERNAME_RE = /^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$/;
+
+/** Only explicit, known platforms build account references; nothing is invented. */
+const KNOWN_PLATFORMS = new Set([
+  'github',
+  'x',
+  'twitter',
+  'reddit',
+  'gitlab',
+  'youtube',
+  'tiktok',
+  'instagram',
+  'linkedin'
+]);
+
+function baseClassification(
+  kind: ResearchInputKind,
+  originalValue: string,
+  normalizedValue: string,
+  sensitive: boolean
+): ResearchInputClassification {
+  return {
+    kind,
+    originalValue,
+    normalizedValue,
+    displayValue: sensitive ? redactEmailValue(normalizedValue) : originalValue,
+    sensitive,
+    anchors: [],
+    accountSeed: null,
+    ambiguities: [],
+    intendedScope: 'unresolved',
+    notes: []
+  };
+}
+
+/**
+ * Pure local parse/classify. Never guesses a platform from a bare username,
+ * never infers a person from an account, never contacts anything. URL-like
+ * tokens that are invalid or unsafe are rejected outright instead of falling
+ * back into a generic question.
+ */
+export function classifyResearchInput(raw: unknown): ClassificationResult {
+  const original = typeof raw === 'string' ? raw.trim() : '';
+  if (original.length === 0) {
+    return { ok: false, code: 'invalid_input_url', error: '请输入姓名、公开主页或研究问题。' };
+  }
+
+  const tokens = tokenizeInput(original);
+  // URL-like tokens are validated first: an invalid or unsafe URL must be
+  // rejected outright and can never fall back into a generic question (or be
+  // mistaken for an email token inside its credentials).
+  for (const { token, urlLike } of tokens) {
+    if (!urlLike) continue;
+    const parsed = parsePublicUrl(token);
+    if (!parsed.ok) return parsed;
+  }
+  const urlTokens = tokens.filter((entry) => entry.urlLike);
+  const parsedUrls: ParsedUrl[] = [];
+  for (const { token } of urlTokens) {
+    const parsed = parsePublicUrl(token);
+    if (parsed.ok) parsedUrls.push(parsed.parsed);
+  }
+  const nonUrlText = tokens
+    .filter((entry) => !entry.urlLike)
+    .map((entry) => entry.token)
+    .join(' ');
+
+  // Email lineage: a bare email, or any text carrying an email token, is a
+  // sensitive input. It must never fall through to a generic question.
+  const emailValue = normalizeEmailValue(original) ?? findEmailToken(nonUrlText);
+  if (emailValue) {
+    const classification = baseClassification('email', original, emailValue, true);
+    classification.notes.push('邮箱线索仅在明确提交并记录授权后保存；提交前不发送任何请求。');
+    classification.notes.push('邮箱公开匹配（GET-66）尚未实现：不会按用户名猜测或调用任何匹配服务。');
+    classification.intendedScope = 'person_research';
+    return { ok: true, classification };
+  }
+
+  if (parsedUrls.length > 0) {
+    const sole = parsedUrls.length === 1 && urlTokens.length === tokens.length ? parsedUrls[0]! : null;
+    const primary = sole ?? parsedUrls[0]!;
+    const urlClass = classifyParsedUrl(primary);
+    const classification = baseClassification(
+      sole ? 'url' : 'text',
+      original,
+      sole ? primary.normalized : original,
+      false
+    );
+    classification.anchors = urlClass.anchors;
+    classification.accountSeed = urlClass.accountSeed;
+    classification.intendedScope = urlClass.intendedScope;
+    classification.notes.push(...urlClass.notes);
+    if (sole) {
+      // Only a URL-dominated input can silently become an asserted person
+      // seed; a question that merely mentions a URL stays a question.
+      classification.ambiguities = urlClass.ambiguities;
+    } else {
+      classification.notes.push('问题中提到的链接按资源线索记录，不当作已确认的人物主页。');
+    }
+    return { ok: true, classification };
+  }
+
+  const qualified = original.match(PLATFORM_USERNAME_RE);
+  if (qualified && KNOWN_PLATFORMS.has(qualified[1]!.toLowerCase())) {
+    const platform = qualified[1]!.toLowerCase() === 'twitter' ? 'x' : qualified[1]!.toLowerCase();
+    const handle = qualified[2]!;
+    const build = PLATFORM_PROFILE_URL[platform];
+    const classification = baseClassification('platform_username', original, `${platform}:${handle}`, false);
+    classification.accountSeed = {
+      platform,
+      handle,
+      profileUrl: build ? build(handle) : null,
+      accountRole: 'unknown',
+      basis: 'platform_username',
+      note: '平台限定用户名只是该平台的账号线索；不跨平台合并，不升级身份支持。'
+    };
+    classification.anchors = [
+      urlAnchor('intended_subject', 'account', null, { platform, handle, resourceId: handle, note: '平台限定用户名线索。' })
+    ];
+    classification.notes.push(`按 ${platform} 平台规则建立账号引用；不推断自然人身份。`);
+    classification.intendedScope = 'account_only';
+    return { ok: true, classification };
+  }
+
+  if (tokens.length === 1 && BARE_USERNAME_RE.test(original) && /^[A-Za-z0-9._-]+$/.test(original)) {
+    const classification = baseClassification('username_clue', original, original, false);
+    classification.notes.push('裸用户名只是线索：不推断平台、主页或自然人，也不当作已选账号。');
+    return { ok: true, classification };
+  }
+
+  const classification = baseClassification('text', original, original, false);
+  classification.notes.push('按研究问题/姓名处理；没有账号被选中。');
+  return { ok: true, classification };
+}
+
+/* ------------------------------------------------------------------ */
+/* Discovery subject projection (platform discovery intake)           */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Unified classification for a platform-discovery subject. Usernames stay
+ * clues (never merged across platforms, never identity claims); emails are
+ * sensitive and only kept internally with an explicit authorization record.
+ */
+export function discoverySubjectClassification(
+  kind: 'username' | 'email',
+  value: string
+): ResearchInputClassification {
+  if (kind === 'email') {
+    const normalized = normalizeEmailValue(value) ?? value;
+    const classification = baseClassification('email', value, normalized, true);
+    classification.notes.push('发现任务的邮箱线索仅内部保存；公开视图、事件与导出一律脱敏。');
+    classification.notes.push('邮箱公开匹配（GET-66）尚未实现；不按用户名猜测，不调用匹配服务。');
+    classification.intendedScope = 'person_research';
+    return classification;
+  }
+  const classification = baseClassification('username_clue', value, value, false);
+  classification.notes.push('发现任务用户名只是平台探测线索，不代表身份归属。');
+  return classification;
+}
+
+/* ------------------------------------------------------------------ */
+/* Public DTO (never carries a raw or hashed email)                   */
+/* ------------------------------------------------------------------ */
+
+export interface PublicInputView {
+  inputId: string;
+  inputRevision: number;
+  kind: ResearchInputKind;
+  /** Redacted for sensitive kinds; safe for UI, events and exports. */
+  displayValue: string;
+  intendedScope: IntendedScope;
+  status: InputStatus;
+  anchors: InputAnchor[];
+  accountSeed: AccountSeed | null;
+  ambiguities: RoleAmbiguity[];
+  notes: string[];
+}
+
+export interface InputEnvelope {
+  inputId: string;
+  kind: ResearchInputKind;
+  /** Internal only when sensitive; public code must use `displayValue`. */
+  normalizedValue: string;
+  displayValue: string;
+  anchors: InputAnchor[];
+  intendedScope: IntendedScope;
+  ownerId: string;
+  /** Resolved by the server against its own authorization table. */
+  authorizationRef?: string | null;
+  inputRevision: number;
+  status: InputStatus;
+  /** The full local classification this revision was created from. */
+  classification: ResearchInputClassification;
+  createdAt: string;
+}
+
+/** Public projection of an envelope: no raw email, no hash, ever. */
+export function toPublicInputView(envelope: InputEnvelope): PublicInputView {
+  return {
+    inputId: envelope.inputId,
+    inputRevision: envelope.inputRevision,
+    kind: envelope.kind,
+    displayValue: envelope.kind === 'email' ? redactEmailValue(envelope.normalizedValue) : envelope.displayValue,
+    intendedScope: envelope.intendedScope,
+    status: envelope.status,
+    anchors: envelope.anchors,
+    accountSeed: envelope.classification.accountSeed,
+    ambiguities: envelope.status === 'needs_role_confirmation' ? envelope.classification.ambiguities : [],
+    notes: envelope.classification.notes
+  };
+}
