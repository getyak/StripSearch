+/**
+ * GET-62 input intake service: the one place where a submission is classified,
+ * validated, persisted and admitted to scheduling.
+ *
+ * Atomicity contract:
+ *
+ * - A submission writes its input revision (and, for emails, its explicit
+ *   authorization record; for seeds, its case/account scope change), the run,
+ *   the input binding and the idempotency key in ONE transaction. A failing
+ *   second reference (foreign parent, foreign/stale role choice, invalid
+ *   authorization reference, stale scope) rolls the whole submission back —
+ *   no orphan input, authorization, scope journal, run, binding or
+ *   idempotency rows, and the queue sees nothing.
+ * - Scheduling happens strictly post-commit (`runner.enqueue` in the route).
+ *   The enqueue is fire-and-forget; a queue trigger failure after commit keeps
+ *   the durable run and its idempotency record, and a retry of the same key
+ *   returns the same record without re-advancing scope.
+ *
+ * Boundaries:
+ *
+ * - Email inputs need an explicit, server-resolved self/consent authorization
+ *   bound to actor + owner + normalized value + input revision. Generic
+ *   `public_professional` is not authorization for an email clue. GET-66 email
+ *   matching is NOT implemented: an authorized email is stored safely as
+ *   `unsupported_email` in a `needs_input` run that is never queued, with an
+ *   honest public-profile fallback path. No provider/planner call ever sees
+ *   the raw email.
+ * - A clear account seed (personal profile URL, organization page URL,
+ *   platform-qualified username, or a confirmed role choice) becomes
+ *   `userSelection.selected` through the atomic GET-58 scope path.
+ *   `identitySupport` stays `proposed`; no cross-platform identity is claimed.
+ * - Ambiguous resource/publisher roles stay visible: they can only run after a
+ *   role confirmation that the server re-validates against its own stored
+ *   classification, and confirming the publisher account never upgrades
+ *   identity support or merges author/publisher/subject.
+ */
+
+import type { IdentityDraft, ProviderName } from '../../shared/types.js';
+import type { AccountDraft } from './case-store.js';
+import { asScopeVersion } from '../../shared/research-case.js';
+import type { ResearchCase, ScopeVersion } from '../../shared/research-case.js';
+import { RESEARCH_INPUT_SCHEMA_VERSION, classifyResearchInput } from '../../shared/research-input.js';
+import type {
+  PublicInputView,
+  ResearchInputClassification,
+  RoleAmbiguity,
+  RoleChoiceValue
+} from '../../shared/research-input.js';
+import {
+  extractGitHubHandle,
+  extractResearchUrl,
+  isPublicHttpsUrl,
+  normalizeResearchUrl,
+  screenQuestion,
+  validateSeedUrl
+} from '../../shared/validation.js';
+import { HttpError } from '../http/errors.js';
+import { InputAuthorizationError } from './input-store.js';
+import type {
+  InputAuthorizationBasis,
+  InputAuthorizationRecord,
+  InputRevisionRecord
+} from './input-store.js';
+import type { RunRecord, Store } from '../store.js';
+
+export interface RoleChoiceRequest {
+  choice: RoleChoiceValue;
+  /** Optional explicit binding to the classification the user confirmed. */
+  inputId?: string;
+  inputRevision?: number;
+}
+
+export type EmailConsentRequest =
+  | { basis: InputAuthorizationBasis }
+  | { authorizationRef: string };
+
+export interface SubmitConfig {
+  researchConfigured: boolean;
+  exaConfigured: boolean;
+}
+
+export interface SubmitInputRequest {
+  ownerId: string;
+  /** Normalized question text (whitespace collapsed). */
+  text: string;
+  /** Legacy explicit seed field. */
+  legacySeedUrl: string | null;
+  provider: ProviderName;
+  parentRunId: string | null;
+  retryOf: string | null;
+  followup: boolean;
+  caseId: string | null;
+  expectedScopeVersion: number | null;
+  roleChoice: RoleChoiceRequest | null;
+  emailConsent: EmailConsentRequest | null;
+  idempotencyKey: string | null;
+  fingerprint: string;
+  config: SubmitConfig;
+}
+
+export interface SubmitInputResult {
+  run: RunRecord;
+  input: PublicInputView;
+  caseId: string;
+  scopeVersion: ScopeVersion;
+  /** Honest GET-66 gap: the email is stored but cannot be matched yet. */
+  emailUnsupported: boolean;
+  roleAmbiguity: RoleAmbiguity[];
+  /** False for needs_input outcomes that must never be queued. */
