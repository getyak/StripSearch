+        ownerId,
+        question: isEmail ? revision.displayValue : request.text,
+        seedUrl: this.runSeedUrl(classification, request.legacySeedUrl, request.provider).seed,
+        provider: request.provider,
+        parentRunId: request.parentRunId,
+        retryOf: request.retryOf,
+        followup: request.followup,
+        idempotencyKey: request.idempotencyKey,
+        bodyFingerprint: request.fingerprint,
+        identity
+      });
+      if (!queueable) {
+        const extra: Record<string, unknown> = emailUnsupported
+          ? {
