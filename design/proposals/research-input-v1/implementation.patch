+    return this.store.inputs.transaction(() => {
+      // Role confirmations that reference a stored input continue that input's
+      // case line; a stale or foreign reference is rejected before anything
+      // else can be attributed to the wrong object.
+      let roleSource: { inputId: string; revision: number; caseId: string } | null = null;
+      if (request.roleChoice?.inputId) {
+        const stored = this.store.inputs.latestRevision(ownerId, request.roleChoice.inputId);
+        if (!stored) throw new HttpError(404, 'input_not_found', '未找到该输入记录。');
+        if (request.roleChoice.inputRevision !== undefined && request.roleChoice.inputRevision !== stored.revision) {
+          throw new HttpError(409, 'stale_input', '输入已更新，请刷新后重新确认。');
+        }
+        if (request.caseId && request.caseId !== stored.caseId) {
+          throw new HttpError(409, 'role_choice_conflict', '输入记录不属于该研究案例。');
+        }
+        roleSource = { inputId: stored.inputId, revision: stored.revision, caseId: stored.caseId };
+      }
