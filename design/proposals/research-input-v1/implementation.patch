+/* ------------------------------------------------------------------ */
+/* Account seeds, account-less inputs and legacy body shapes           */
+/* ------------------------------------------------------------------ */
+
+test('a clear account seed becomes a selected account scope without upgrading identity', async (t) => {
+  const transport = new DenyTransport();
+  const server = await startTestServer({ providerFactory: createFakeFactory(), transport }, {}, {});
+  t.after(() => server.close());
+  await server.client.signUp('seed-owner@example.test');
+  const owner = await currentUser(server.client);
+
+  const created = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: 'https://github.com/fixture-owner', provider: 'github' }
+  });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.queued, true);
+  assert.equal(created.body.input?.kind, 'url');
+  assert.equal(created.body.roleAmbiguity.length, 0);
+
+  const cases = server.store.cases.listCases(owner.id);
+  assert.equal(cases.length, 1);
+  const caseId = cases[0]!.caseId;
+  const accounts = server.store.cases.listAccounts(owner.id, caseId);
+  assert.equal(accounts.length, 1);
+  // A clear seed is the user's selection; identity evidence stays proposed.
+  assert.equal(accounts[0]?.platform, 'github');
+  assert.equal(accounts[0]?.handle, 'fixture-owner');
+  assert.equal(accounts[0]?.userSelection.state, 'selected');
+  assert.equal(accounts[0]?.identitySupport.state, 'proposed');
+  assert.equal(accounts[0]?.identitySupport.evidenceIds.length, 0);
+  assert.equal(accounts[0]?.allowedScope.state, 'public_history');
+  // Scope advanced through the authoritative GET-58 path (v1 case + selection).
+  assert.equal(cases[0]?.scopeVersion, 2);
+  const history = server.store.cases.scopeHistory(owner.id, caseId);
+  assert.equal(history.at(-1)?.reason, 'input_account_selected');
+  // The run is bound to the exact input revision it studies.
+  const binding = server.store.inputs.bindingForRun(created.body.run.runId);
+  assert.equal(binding?.inputRevision, 1);
+  assert.equal(binding?.caseId, caseId);
+  // Explicit seeds may run immediately; identity is not upgraded anywhere.
+  assert.equal(accounts[0]?.identitySupport.state, 'proposed');
+
+  // A first input without an account works without fake account ids.
+  const plain = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: { input: 'Research Ada Fixture', provider: 'github' }
+  });
+  assert.equal(plain.status, 201);
+  const plainCaseId = server.store.inputs.latestRevision(owner.id, plain.body.input!.inputId)!.caseId;
+  assert.notEqual(plainCaseId, caseId);
+  assert.equal(server.store.cases.listAccounts(owner.id, plainCaseId).length, 0);
+
+  // The legacy question/seed body shape still works and selects the seed account.
+  const legacy = await server.client.json<RunResponse>('/api/runs', {
+    method: 'POST',
+    json: {
+      question: 'example 的公开作品有哪些？',
+      seedUrl: 'https://github.com/example',
+      provider: 'github'
+    }
+  });
+  assert.equal(legacy.status, 201);
+  assert.equal(legacy.body.queued, true);
+  const legacyCaseId = server.store.inputs.latestRevision(owner.id, legacy.body.input!.inputId)!.caseId;
+  const legacyAccounts = server.store.cases.listAccounts(owner.id, legacyCaseId);
+  assert.equal(legacyAccounts.length, 1);
+  assert.equal(legacyAccounts[0]?.handle, 'example');
+  assert.equal(transport.calls.length, 0);
+});
