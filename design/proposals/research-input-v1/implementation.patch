+-- GET-62 unified research input. One row per input revision (append-only):
+-- the original value stays owner-private inside this table; public DTOs,
+-- events, reports and exports only ever see display_value (redacted for
+-- sensitive kinds). Object changes append a new revision instead of editing
+-- history.
+CREATE TABLE IF NOT EXISTS research_inputs (
+  input_id TEXT NOT NULL,
+  revision INTEGER NOT NULL,
+  owner_id TEXT NOT NULL,
+  case_id TEXT NOT NULL REFERENCES research_cases(id) ON DELETE CASCADE,
+  kind TEXT NOT NULL,
+  internal_value TEXT NOT NULL,
+  normalized_value TEXT NOT NULL,
+  display_value TEXT NOT NULL,
+  sensitive INTEGER NOT NULL DEFAULT 0,
+  intended_scope TEXT NOT NULL,
+  status TEXT NOT NULL,
+  classification_json TEXT NOT NULL,
+  created_at TEXT NOT NULL,
+  PRIMARY KEY (input_id, revision)
+);
+CREATE INDEX IF NOT EXISTS research_inputs_case ON research_inputs(case_id, input_id, revision);
+CREATE INDEX IF NOT EXISTS research_inputs_owner ON research_inputs(owner_id, created_at);
+
+-- Narrow, explicit subject-email authorization records (self / consent).
